---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Round Robin Pro, copy fetched live from https://attio.com/apps/round-robin-pro
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "round-robin-pro");
if (!app) throw new Error("Missing app detail: round-robin-pro");
---

<AppDetail app={app} />
