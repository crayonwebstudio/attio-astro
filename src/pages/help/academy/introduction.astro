---
import HelpCourse from "../../../components/HelpCourse.astro";
import help from "../../../data/help.json";

// Introductions, copy fetched live from https://attio.com/help/academy/introduction
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "academy/introduction");
if (!entry) throw new Error("Missing help data for academy/introduction");
---

<HelpCourse entry={entry} />
