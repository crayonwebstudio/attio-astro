---
import HelpArticle from "../../../../../components/HelpArticle.astro";
import help from "../../../../../data/help.json";

// Import data into Attio via CSV, copy fetched live from https://attio.com/help/reference/imports-exports/csv-imports/import-data-into-attio-via-csv
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/imports-exports/csv-imports/import-data-into-attio-via-csv");
if (!entry) throw new Error("Missing help data for reference/imports-exports/csv-imports/import-data-into-attio-via-csv");
---

<HelpArticle entry={entry} />
