---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// We held our first hackathon, copy fetched live from https://attio.com/blog/we-held-our-first-hackathon
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "we-held-our-first-hackathon");
if (!post) throw new Error("Missing post data for we-held-our-first-hackathon");
---

<BlogPost post={post} />
