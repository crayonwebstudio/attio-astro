---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Lead Mapper, copy fetched live from https://attio.com/apps/lead-mapper
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "lead-mapper");
if (!app) throw new Error("Missing app detail: lead-mapper");
---

<AppDetail app={app} />
