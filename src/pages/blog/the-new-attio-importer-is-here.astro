---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// The new Attio importer is here, copy fetched live from https://attio.com/blog/the-new-attio-importer-is-here
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "the-new-attio-importer-is-here");
if (!post) throw new Error("Missing post data for the-new-attio-importer-is-here");
---

<BlogPost post={post} />
