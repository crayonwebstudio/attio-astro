---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Caddie AI, copy fetched live from https://attio.com/apps/caddie-ai
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "caddie-ai");
if (!app) throw new Error("Missing app detail: caddie-ai");
---

<AppDetail app={app} />
