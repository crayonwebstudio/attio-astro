        <h3 class="mt-1 font-semibold group-hover:text-blue-500">Redesigned record pages</h3>
        <p class="mt-1 text-sm text-ink-600">All your data right where you need it.</p>
      </a>
    </div>
  </section>

  <!-- Newsletter, no submission -->
  <section class="mx-auto max-w-[1200px] px-4 py-20 text-center sm:px-6">
    <h2 class="font-display text-heading-md font-semibold tracking-tight sm:text-heading-lg">Stay ahead of GTM.</h2>
    <p class="mt-3 text-lg text-ink-600">Product updates in your inbox.</p>
    <form id="newsletter-form" class="mx-auto mt-8 flex max-w-md flex-col gap-3 sm:flex-row">
      <label for="newsletter-email" class="sr-only">Your email address</label>
      <input
        id="newsletter-email"
        type="email"
        required
        placeholder="Your email address"
        class="flex-1 rounded-full border border-paper-500 px-5 py-3 text-sm outline-none focus:border-blue-500 focus:ring-2 focus:ring-blue-500/30"
      />
      <button type="submit" class="rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300">
        Subscribe
      </button>
    </form>
  </section>
</BaseLayout>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  // Hero: cycle 3 frames about every 10 seconds, type the Ask Attio prompt.
  const frames = Array.from(document.querySelectorAll("[data-hero-frame]"));
  const typingEl = document.querySelector("[data-typing]");
  let frameIndex = 0;
  let typeTimer = null;
  const typePrompt = () => {
    if (!typingEl) return;
    const full = typingEl.getAttribute("data-text") || "";
    if (reduceMotion) {
      typingEl.textContent = "";
      return;
    }
    let i = 0;
    typingEl.textContent = "";
    if (typeTimer) window.clearInterval(typeTimer);
    typeTimer = window.setInterval(() => {
      i += 1;
      typingEl.textContent = full.slice(0, i);
      if (i >= full.length && typeTimer) window.clearInterval(typeTimer);
    }, 45);
  };
  const showFrame = (index) => {
    frames.forEach((frame, i) => {
      frame.hidden = i !== index;
    });
    if (index === 0) typePrompt();
  };
  showFrame(0);
  if (!reduceMotion && frames.length > 1) {
    window.setInterval(() => {
      frameIndex = (frameIndex + 1) % frames.length;
      showFrame(frameIndex);
    }, 10000);
  }

  // Platform scrollspy: active nav item gets black text and a blue left border.
  const spyLinks = Array.from(document.querySelectorAll("[data-spy]"));
  const spySections = spyLinks
    .map((link) => document.getElementById(link.getAttribute("data-spy") || ""))
    .filter((el) => el !== null);
  const setActiveSpy = (id) => {
    spyLinks.forEach((link) => {
      const active = link.getAttribute("data-spy") === id;
      link.classList.toggle("text-ink-100", active);
      link.classList.toggle("border-blue-500", active);
      link.classList.toggle("border-transparent", !active);
    });
  };
  if (spySections.length > 0) {
    const spyObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) setActiveSpy(entry.target.id);
        });
      },
      { rootMargin: "-20% 0px -70% 0px" }
    );
    spySections.forEach((section) => spyObserver.observe(section));
    setActiveSpy(spySections[0].id);
  }

  // Signals accordion: one panel open at a time, Context open by default.
  document.querySelectorAll("[data-accordion]").forEach((accordion) => {
    const buttons = Array.from(accordion.querySelectorAll("[data-accordion-button]"));
    buttons.forEach((button) => {
      button.addEventListener("click", () => {
        const panel = button.parentElement?.querySelector("[data-accordion-panel]");
        const isOpen = button.getAttribute("aria-expanded") === "true";
        buttons.forEach((other) => {
          other.setAttribute("aria-expanded", "false");
          const otherPanel = other.parentElement?.querySelector("[data-accordion-panel]");
          if (otherPanel) otherPanel.hidden = true;
        });
        if (!isOpen && panel) {
          button.setAttribute("aria-expanded", "true");
          panel.hidden = false;
        }
      });
    });
  });

  // Customer story tabs.
  const storyTabs = Array.from(document.querySelectorAll("[data-story-tab]"));
  storyTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      const key = tab.getAttribute("data-story-tab");
      storyTabs.forEach((other) => {
        const active = other === tab;
        other.setAttribute("aria-selected", String(active));
        other.classList.toggle("bg-ink-100", active);
        other.classList.toggle("text-white", active);
        other.classList.toggle("bg-paper-300", !active);
        other.classList.toggle("text-ink-100", !active);
      });
      document.querySelectorAll("[data-story-panel]").forEach((panel) => {
        panel.hidden = panel.getAttribute("data-story-panel") !== key;
      });
    });
  });

  // Count-up stats on view.
  const counters = Array.from(document.querySelectorAll("[data-count-up]"));
  const runCounter = (el) => {
    const target = parseFloat(el.getAttribute("data-target") || "0");
    const suffix = el.getAttribute("data-suffix") || "";
    const decimals = parseInt(el.getAttribute("data-decimals") || "0", 10);
    if (reduceMotion) {
      el.textContent = target.toFixed(decimals) + suffix;
      return;
    }
    const start = performance.now();
    const duration = 1200;
    const tick = (now) => {
      const progress = Math.min((now - start) / duration, 1);
      const value = target * (1 - Math.pow(1 - progress, 3));
      el.textContent = value.toFixed(decimals) + suffix;
      if (progress < 1) window.requestAnimationFrame(tick);
    };
    window.requestAnimationFrame(tick);
  };
  if (counters.length > 0) {
    const counterObserver = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            runCounter(entry.target);
            counterObserver.unobserve(entry.target);
          }
        });
      },
      { threshold: 0.4 }
    );
    counters.forEach((el) => counterObserver.observe(el));
  }

  // Newsletter: no submission, show a subscribed state on the button only.
  const newsletterForm = document.getElementById("newsletter-form");
  newsletterForm?.addEventListener("submit", (event) => {
    event.preventDefault();
    const button = newsletterForm.querySelector("button[type='submit']");
    if (button) {
      button.textContent = "Subscribed";
      button.disabled = true;
    }
  });
</script>
