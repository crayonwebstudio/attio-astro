---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Workflow Chain, copy fetched live from https://attio.com/apps/workflow-chain
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "workflow-chain");
if (!app) throw new Error("Missing app detail: workflow-chain");
---

<AppDetail app={app} />
