---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Slack, copy fetched live from https://attio.com/apps/slack
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "slack");
if (!app) throw new Error("Missing app detail: slack");
---

<AppDetail app={app} />
