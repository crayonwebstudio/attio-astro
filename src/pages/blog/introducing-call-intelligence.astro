---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Introducing Call Intelligence, copy fetched live from https://attio.com/blog/introducing-call-intelligence
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "introducing-call-intelligence");
if (!post) throw new Error("Missing post data for introducing-call-intelligence");
---

<BlogPost post={post} />
