---
// Renders inline segments (text, bold, italic, code, links) for help articles.
// Segment model shared with src/data/posts.json.
interface Segment {
  t: string;
  b?: boolean;
  i?: boolean;
  code?: boolean;
  href?: string;
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
---

{segments.map((part) =>
  part.href ? (
    <a
      href={part.href}
      class="text-blue-500 underline underline-offset-2 hover:text-blue-600"
    >
      {part.t}
    </a>
  ) : part.code ? (
    <code class="rounded bg-paper-200 px-1 py-0.5 font-mono text-[0.9em]">{part.t}</code>
  ) : part.b ? (
    <strong class="font-semibold">{part.t}</strong>
  ) : part.i ? (
    <em>{part.t}</em>
  ) : (
    part.t
  )
)}
