---
import WorkflowTemplate from "../../../components/WorkflowTemplate.astro";
import templates from "../../../data/templates.json";

// Pass won deals to Customer Success, copy fetched live from https://attio.com/templates/sales/pass-won-deals-to-customer-success
// on 2026-11-17 (HTTP 200). Data lives in src/data/templates.json.
const entry = (templates as any[]).find((entry) => entry.path === "/templates/sales/pass-won-deals-to-customer-success");
if (!entry) throw new Error("Missing template data for /templates/sales/pass-won-deals-to-customer-success");
---

<WorkflowTemplate entry={entry} />
