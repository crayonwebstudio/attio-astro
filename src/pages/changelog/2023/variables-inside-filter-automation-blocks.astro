---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Variables inside filter automation blocks, copy fetched live from https://attio.com/changelog/2023/variables-inside-filter-automation-blocks
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2023/variables-inside-filter-automation-blocks");
if (!entry) throw new Error("Missing changelog data for /changelog/2023/variables-inside-filter-automation-blocks");
---

<ChangelogEntry entry={entry} />
