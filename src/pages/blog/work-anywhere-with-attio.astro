---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Work anywhere with Attio, copy fetched live from https://attio.com/blog/work-anywhere-with-attio
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "work-anywhere-with-attio");
if (!post) throw new Error("Missing post data for work-anywhere-with-attio");
---

<BlogPost post={post} />
