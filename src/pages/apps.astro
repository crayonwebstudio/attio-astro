---
import BaseLayout from "../layouts/BaseLayout.astro";
import appsData from "../data/apps.json";

// Copy fetched live from https://attio.com/apps on 2026-11-16 (HTTP 200, 2.8MB).
// Product visuals are rebuilt as HTML/CSS mocks, no Attio images are hotlinked or copied.
// Live H1 is "Apps & integrations" (the headline "One platform, endless possibilities."
// is an H2 on live), rendered the same with one H1. Live has NO standard FinalCta
// ("Agentic revenue runs on Attio." appears 0 times in the live HTML), so this page
// hides the shared FinalCta and ends with the live "Build with us." section instead.
// All 299 app cards are live copy: name, vendor, description, category and the
// Official app badge, parsed from the live DOM (11 categories, counts verified:
// Analytics 26, Automations 75, Billing 12, Calling 36, Communication 25,
// Customer support 10, Data and enrichment 75, E-mail sequencing 9,
// Forms and surveys 11, Product management 15, Storage 5). The two live descriptions
// that use em dashes (Composio, Clay) are rendered with commas per the no em dash rule.
// Card icons on live are Storyblok app avatars, rendered here as initials tiles.
// "Browse apps" is a button on live that scrolls to the directory, rendered as an
// anchor to #discover-apps. The live search is a command palette (Search, Cmd+K),
// rebuilt as a client-side overlay that filters the 299 cards. Detail pages are not
// built yet, so card links 404 until then.
const categories = appsData.categories;
const total = categories.reduce((n, c) => n + c.apps.length, 0);

const initials = (name: string) => {
  const words = name.replace(/[^A-Za-z0-9 ]/g, "").split(" ").filter(Boolean);
  if (words.length >= 2) return (words[0][0] + words[1][0]).toUpperCase();
  return name.replace(/[^A-Za-z0-9]/g, "").slice(0, 2).toUpperCase();
};

const tileHue = (name: string) => {
  let h = 0;
  for (const ch of name) h = (h * 31 + ch.charCodeAt(0)) % 360;
  return h;
};
---

<BaseLayout
  title="App Store | Attio"
  description="Discover apps and integrations to help you do more with Attio and scale your business."
  hideFinalCta
>
  <!-- Hero -->
  <section class="mx-auto max-w-[1200px] px-4 pb-12 pt-16 text-center sm:px-6 sm:pt-24">
    <h1 class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-500">Apps &amp; integrations</h1>
    <h2 class="mx-auto mt-6 max-w-3xl font-display text-[44px] font-semibold leading-[1.05] tracking-tight sm:text-[56px]">
      One platform, endless possibilities.
    </h2>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 sm:text-xl">
      The tools you already love and new ideas to scale your business.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#discover-apps"
        class="rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Browse apps
      </a>
      <a
        href="/partners/app-partners"
        class="rounded-full border border-ink-100 px-6 py-3 text-sm font-semibold text-ink-100 hover:bg-paper-200"
      >
        Become an App Partner
      </a>
    </div>
  </section>

  <!-- Everything you need -->
  <section class="mx-auto max-w-[1200px] px-4 pb-16 sm:px-6" aria-label="Everything you need">
    <div class="text-center">
      <h2 class="font-display text-heading-md font-semibold tracking-tight">Everything you need.</h2>
      <p class="mx-auto mt-3 max-w-xl text-lg leading-relaxed text-ink-600">
        Unlock essential apps for your Attio workspace.
      </p>
    </div>
    <ul class="mt-10 flex flex-wrap items-center justify-center gap-x-10 gap-y-4" aria-label="Featured apps">
      {["Typeform", "Zapier", "Slack", "Aircall", "Mailchimp"].map((name) => (
        <li class="font-display text-2xl font-semibold tracking-tight text-ink-300">{name}</li>
      ))}
    </ul>
    <div class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-2xl border border-paper-500 bg-white">
      <div class="flex items-start gap-4 border-b border-paper-400 bg-paper-200 p-6 sm:p-8">
        <span
          class="flex h-12 w-12 shrink-0 items-center justify-center rounded-[30%] text-base font-semibold text-white"
          style={`background-color: hsl(210 70% 45%)`}
        >
          Ty
        </span>
        <div>
          <h3 class="font-display text-2xl font-semibold tracking-tight">Typeform</h3>
          <p class="mt-1 text-sm text-ink-600">By Attio</p>
        </div>
      </div>
      <div class="p-6 sm:p-8">
        <p class="max-w-md text-lg leading-relaxed text-ink-600">
          Link and respond to Typeform form submissions inside Attio.
        </p>
        <a
          href="/apps/typeform"
          class="mt-6 inline-flex items-center gap-2 rounded-full border border-ink-100 px-5 py-2.5 text-sm font-semibold text-ink-100 hover:bg-paper-200"
        >
          Learn more
          <span aria-hidden="true">&rarr;</span>
        </a>
      </div>
    </div>
  </section>

  <!-- Discover apps -->
  <section id="discover-apps" class="mx-auto max-w-[1200px] scroll-mt-24 px-4 pb-20 sm:px-6" aria-label="Discover apps">
    <div class="text-center">
      <h2 class="font-display text-heading-md font-semibold tracking-tight">Discover apps.</h2>
      <p class="mx-auto mt-3 max-w-xl text-lg leading-relaxed text-ink-600">
        Supercharge your workflow with powerful integrations that work seamlessly within Attio.
      </p>
    </div>
    <div class="mt-8 flex w-full items-center justify-center">
      <button
        id="apps-search-open"
        type="button"
        class="flex w-full min-w-80 max-w-80 items-center gap-2 rounded-xl border border-paper-500 bg-white px-3.5 py-3 text-sm text-ink-600 shadow-sm hover:border-ink-300"
      >
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.2"
            d="m15.8 15.8-3.62-3.62M1.8 7.833a6.034 6.034 0 1 1 12.069 0 6.034 6.034 0 0 1-12.07 0Z"
          />
        </svg>
        <span class="w-full truncate text-left">Search&hellip;</span>
        <span class="text-xs tracking-wider text-ink-700" aria-hidden="true">&#8984;K</span>
      </button>
    </div>

    <div class="mt-12 grid gap-10 lg:grid-cols-[220px_1fr]">
      <aside class="hidden lg:block" aria-label="Categories">
        <div class="sticky top-32">
          <p class="text-sm font-semibold uppercase tracking-[0.15em] text-ink-700">Categories</p>
          <ul class="mt-4 space-y-1">
            {categories.map((cat) => (
              <li>
                <a
                  href={`#${cat.id}`}
                  class="flex items-center justify-between rounded-lg px-3 py-2 text-sm font-medium text-ink-100 hover:bg-paper-200"
                >
                  {cat.name}
                  <span class="text-xs text-ink-700">{cat.apps.length}</span>
                </a>
              </li>
            ))}
          </ul>
          <p class="mt-6 px-3 text-xs leading-relaxed text-ink-700">{total} apps</p>
        </div>
      </aside>

      <div class="min-w-0">
        <div class="mb-8 flex gap-2 overflow-x-auto pb-2 lg:hidden" aria-label="Categories">
          {categories.map((cat) => (
            <a
              href={`#${cat.id}`}
              class="shrink-0 rounded-full border border-paper-500 bg-white px-4 py-2 text-sm font-medium text-ink-100"
            >
              {cat.name}
            </a>
          ))}
        </div>

        {categories.map((cat) => (
          <div id={cat.id} class="scroll-mt-32 pb-14">
            <h3 class="text-sm font-semibold uppercase tracking-[0.15em] text-ink-700">{cat.name}</h3>
            <div class="mt-6 grid gap-4 sm:grid-cols-2">
              {cat.apps.map((app) => (
                <a
                  href={`/apps/${app.slug}`}
                  class="app-card group relative flex flex-col gap-3.5 overflow-hidden rounded-2xl border border-paper-500 bg-white p-5 transition-colors hover:border-ink-300"
                  data-name={app.name.toLowerCase()}
                  data-vendor={app.vendor.toLowerCase()}
                  data-desc={app.description.toLowerCase()}
                >
                  <div class="relative flex items-center justify-between">
                    <div class="flex items-center gap-2.5">
                      <span
                        class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-[30%] text-sm font-semibold text-white"
                        style={`background-color: hsl(${tileHue(app.name)} 65% 45%)`}
                        aria-hidden="true"
                      >
                        {initials(app.name)}
                      </span>
                      <span class="font-display text-lg font-semibold tracking-tight">{app.name}</span>
                      {app.official && (
                        <span
                          class="flex h-4 w-4 items-center justify-center rounded-full bg-green-600 text-[10px] font-bold text-white"
                          title="Official app"
                          aria-label="Official app"
                        >
                          &#10003;
                        </span>
                      )}
                    </div>
                    <span class="text-ink-700 opacity-0 transition-opacity group-hover:opacity-100" aria-hidden="true">&rarr;</span>
                  </div>
                  <p class="text-sm text-ink-600">By {app.vendor}</p>
                  <p class="text-sm leading-relaxed text-ink-600">{app.description}</p>
                </a>
              ))}
            </div>
          </div>
        ))}
        <p id="apps-empty" class="hidden text-base text-ink-600">No apps match your search.</p>
      </div>
    </div>
  </section>

  <!-- Build with us -->
  <section class="mx-auto max-w-[1200px] px-4 pb-24 text-center sm:px-6" aria-label="Build with us">
    <h2 class="font-display text-heading-md font-semibold tracking-tight">Build with us.</h2>
    <p class="mx-auto mt-3 max-w-xl text-lg leading-relaxed text-ink-600">
      Develop your own integration for our ecosystem.
    </p>
    <a
      href="/partners/app-partners"
      class="mt-8 inline-flex rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
    >
      Become an App Partner
    </a>
  </section>

  <!-- Search overlay -->
  <div id="apps-search-overlay" class="fixed inset-0 z-[100] hidden items-start justify-center bg-black/50 px-4 pt-24" role="dialog" aria-modal="true" aria-label="Search apps">
    <div class="w-full max-w-lg overflow-hidden rounded-2xl border border-paper-500 bg-white shadow-xl">
      <div class="flex items-center gap-2 border-b border-paper-400 px-4 py-3">
        <svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
          <path
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.2"
            d="m15.8 15.8-3.62-3.62M1.8 7.833a6.034 6.034 0 1 1 12.069 0 6.034 6.034 0 0 1-12.07 0Z"
          />
        </svg>
        <input
          id="apps-search-input"
          type="text"
          placeholder="Search apps…"
          autocomplete="off"
          class="w-full text-sm outline-none placeholder:text-ink-700"
        />
        <button id="apps-search-close" type="button" class="rounded-md px-2 py-1 text-xs font-semibold text-ink-700 hover:bg-paper-200" aria-label="Close search">
          Esc
        </button>
      </div>
      <ul id="apps-search-results" class="max-h-80 overflow-y-auto p-2"></ul>
      <p id="apps-search-empty" class="hidden px-4 py-6 text-sm text-ink-600">No apps match your search.</p>
    </div>
  </div>
</BaseLayout>

<script>
  // Search overlay, as on live (Search button, Cmd+K). Filters the 299 cards
  // by name, vendor, or description and links to the app detail page.
  const overlay = document.getElementById("apps-search-overlay");
  const openBtn = document.getElementById("apps-search-open");
  const closeBtn = document.getElementById("apps-search-close");
  const input = document.getElementById("apps-search-input");
  const results = document.getElementById("apps-search-results");
  const empty = document.getElementById("apps-search-empty");
  const cards = Array.from(document.querySelectorAll(".app-card"));

  const openSearch = () => {
    if (!overlay) return;
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    renderResults("");
    if (input) input.focus();
  };
  const closeSearch = () => {
    if (!overlay) return;
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    if (input) input.value = "";
  };

  function renderResults(query) {
    const q = query.trim().toLowerCase();
    const matches = q
      ? cards.filter((card) => {
          const hay = `${card.getAttribute("data-name") || ""} ${card.getAttribute("data-vendor") || ""} ${card.getAttribute("data-desc") || ""}`;
          return hay.includes(q);
        })
      : cards.slice(0, 8);
    if (!results) return;
    results.innerHTML = "";
    matches.slice(0, 8).forEach((card) => {
      const li = document.createElement("li");
      const a = document.createElement("a");
      a.href = card.getAttribute("href") || "#";
      a.className = "flex items-center justify-between rounded-lg px-3 py-2.5 text-sm hover:bg-paper-200";
      const name = card.querySelector(".font-display")?.textContent || "";
      const vendor = card.querySelector("p")?.textContent || "";
      a.innerHTML = "";
      const left = document.createElement("span");
      left.innerHTML = `<span class="font-semibold"></span> <span class="text-ink-600"></span>`;
      left.querySelector(".font-semibold").textContent = name;
      left.querySelector(".text-ink-600").textContent = vendor;
      const arrow = document.createElement("span");
      arrow.className = "text-ink-700";
      arrow.textContent = "→";
      a.appendChild(left);
      a.appendChild(arrow);
      li.appendChild(a);
      results.appendChild(li);
    });
    if (empty) empty.classList.toggle("hidden", matches.length > 0);
  }

  if (openBtn) openBtn.addEventListener("click", openSearch);
  if (closeBtn) closeBtn.addEventListener("click", closeSearch);
  if (overlay) {
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) closeSearch();
    });
  }
  if (input) input.addEventListener("input", () => renderResults(input.value));
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (overlay && overlay.classList.contains("hidden")) openSearch();
      else closeSearch();
    }
    if (event.key === "Escape") closeSearch();
  });
</script>
