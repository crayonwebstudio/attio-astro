---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Grant workspace access to an Attio Expert, copy fetched live from https://attio.com/help/reference/workspace-settings-billing/expert-access-grants
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
