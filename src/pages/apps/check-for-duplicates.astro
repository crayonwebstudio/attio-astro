---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Duplicate Detection & Merging, copy fetched live from https://attio.com/apps/check-for-duplicates
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "check-for-duplicates");
if (!app) throw new Error("Missing app detail: check-for-duplicates");
---

<AppDetail app={app} />
