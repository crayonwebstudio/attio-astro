---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Telegram, copy fetched live from https://attio.com/apps/telegram
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "telegram");
if (!app) throw new Error("Missing app detail: telegram");
---

<AppDetail app={app} />
