---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Advanced Workflow Automations, copy fetched live from https://attio.com/apps/workflow-utilities
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "workflow-utilities");
if (!app) throw new Error("Missing app detail: workflow-utilities");
---

<AppDetail app={app} />
