---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Introducing Ask Attio, copy fetched live from https://attio.com/blog/introducing-ask-attio
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "introducing-ask-attio");
if (!post) throw new Error("Missing post data for introducing-ask-attio");
---

<BlogPost post={post} />
