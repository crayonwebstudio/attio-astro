---
import EngineeringPost from "../../../components/EngineeringPost.astro";
import data from "../../../data/engineering.json";

// How V8’s Liftoff compiler broke our WASM execution, copy fetched live from https://attio.com/engineering/blog/how-v8s-liftoff-compiler-broke-our-wasm-execution
// on 2026-11-16 (HTTP 200). Data lives in src/data/engineering.json.
const post = data.posts.find((entry) => entry.slug === "how-v8s-liftoff-compiler-broke-our-wasm-execution");
if (!post) throw new Error("Missing engineering post data for how-v8s-liftoff-compiler-broke-our-wasm-execution");
---

