---
import HelpCategory from "../../../../components/HelpCategory.astro";
import help from "../../../../data/help.json";

// Sequences, copy fetched live from https://attio.com/help/reference/automations/sequences
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/automations/sequences");
if (!entry) throw new Error("Missing help data for reference/automations/sequences");
---

