---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Regional Task Queue, copy fetched live from https://attio.com/apps/regional-task-queue
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "regional-task-queue");
if (!app) throw new Error("Missing app detail: regional-task-queue");
---

<AppDetail app={app} />
