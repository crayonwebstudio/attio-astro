---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for SpeakSoon, copy fetched live from https://attio.com/apps/speak-soon
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "speak-soon");
if (!app) throw new Error("Missing app detail: speak-soon");
---

<AppDetail app={app} />
