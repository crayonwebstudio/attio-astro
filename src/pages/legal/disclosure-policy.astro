---
import LegalLayout from "../../components/LegalLayout.astro";
import legal from "../../data/legal.json";

// Vulnerability Disclosure Policy, copy fetched live from https://attio.com/legal/disclosure-policy
// on 2026-11-16 (HTTP 200). Data lives in src/data/legal.json.
const entry = (legal as any[]).find((entry) => entry.slug === "disclosure-policy");
if (!entry) throw new Error("Missing legal data for disclosure-policy");
---

<LegalLayout entry={entry} />
