---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for EasyRinger, copy fetched live from https://attio.com/apps/easy-ringer
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "easy-ringer");
if (!app) throw new Error("Missing app detail: easy-ringer");
---

<AppDetail app={app} />
