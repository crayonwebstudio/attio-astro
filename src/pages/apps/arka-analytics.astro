---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Arka Analytics, copy fetched live from https://attio.com/apps/arka-analytics
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "arka-analytics");
if (!app) throw new Error("Missing app detail: arka-analytics");
---

<AppDetail app={app} />
