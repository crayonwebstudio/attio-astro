---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for PromptQL, copy fetched live from https://attio.com/apps/prompt-ql
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "prompt-ql");
if (!app) throw new Error("Missing app detail: prompt-ql");
---

<AppDetail app={app} />
