---
// "Different ways to partner" cross-links, shared by the three partners subpages.
// Copy fetched live from attio.com on 2026-11-16.
interface Pathway {
  href: string;
  label: string;
  title: string;
  subtitle: string;
  link: string;
}

interface Props {
  cards: Pathway[];
  title?: string;
  subtitle?: string;
}

const {
  cards,
  title = "Different ways to partner",
  subtitle = "There are many ways to work with us and help build the next generation of business software.",
} = Astro.props;
---

<section class="mx-auto max-w-[1200px] px-4 pb-24 sm:px-6" aria-label="Different ways to partner">
  <h2 class="font-display text-heading-md font-semibold tracking-tight">{title}</h2>
  <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
    {subtitle}
  </p>
  <div class="mt-10 grid gap-6 md:grid-cols-2">
    {
      cards.map((card) => (
        <a
          href={card.href}
          class="group rounded-2xl border border-paper-500 bg-white p-8 transition-colors hover:bg-paper-200"
        >
          <p class="text-xs font-semibold uppercase tracking-[0.15em] text-ink-700">{card.label}</p>
          <h3 class="mt-4 font-display text-heading-xs font-semibold tracking-tight text-ink-100">
            {card.title}{" "}
            <span class="font-medium text-ink-600">{card.subtitle}</span>
          </h3>
          <p class="mt-6 flex items-center gap-1.5 text-sm font-semibold text-ink-100">
            {card.link}
            <span class="transition-transform duration-300 group-hover:translate-x-1" aria-hidden="true">
              &rarr;
            </span>
          </p>
        </a>
      ))
    }
  </div>
</section>
