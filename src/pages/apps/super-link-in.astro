---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for SuperLinkIn, copy fetched live from https://attio.com/apps/super-link-in
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "super-link-in");
if (!app) throw new Error("Missing app detail: super-link-in");
---

<AppDetail app={app} />
