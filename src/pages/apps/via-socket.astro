---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for viaSocket, copy fetched live from https://attio.com/apps/via-socket
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "via-socket");
if (!app) throw new Error("Missing app detail: via-socket");
---

<AppDetail app={app} />
