---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for First Distro, copy fetched live from https://attio.com/apps/first-distro
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "first-distro");
if (!app) throw new Error("Missing app detail: first-distro");
---

<AppDetail app={app} />
