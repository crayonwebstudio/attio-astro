---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Introducing the architecture for Agentic Revenue, copy fetched live from https://attio.com/blog/introducing-the-architecture-for-agentic-revenue
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "introducing-the-architecture-for-agentic-revenue");
if (!post) throw new Error("Missing post data for introducing-the-architecture-for-agentic-revenue");
---

<BlogPost post={post} />
