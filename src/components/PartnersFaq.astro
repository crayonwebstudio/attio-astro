---
// FAQ accordion shared by the three partners subpages. Answers are live Attio
// copy passed as HTML (links and lists as on live), rendered verbatim.
// Same Expand all behaviour as the help article FAQ.
interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
}

const { items } = Astro.props;
---

<section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Frequently asked questions">
  <div class="flex items-start justify-between gap-4">
    <h2 class="font-display text-[28px] font-semibold leading-tight tracking-tight sm:text-[32px]">
      Frequently asked questions
    </h2>
    <button
      type="button"
      data-expand-all
      class="mt-2 shrink-0 rounded-[10px] border border-paper-500 bg-white px-3 py-1.5 text-sm font-semibold text-ink-100 transition-colors hover:border-ink-800"
    >
      Expand all
    </button>
  </div>
  <div class="mt-6">
    {
      items.map((item) => (
        <details class="border-b border-paper-500 py-7 first:pt-0">
          <summary class="flex cursor-pointer items-start justify-between gap-x-6 text-left font-semibold text-ink-100">
            {item.q}
            <span class="mt-1 shrink-0 text-lg font-normal leading-none text-ink-700" aria-hidden="true">
              +
            </span>
          </summary>
          <div class="faq-answer pr-2 pt-3 text-base leading-relaxed text-ink-600 lg:pr-16" set:html={item.a} />
        </details>
      ))
    }
  </div>
</section>

<script>
  const expandButton = document.querySelector("[data-expand-all]");
  if (expandButton) {
    expandButton.addEventListener("click", () => {
      const details = Array.from(
        document.querySelectorAll("section[aria-label='Frequently asked questions'] details")
      );
      const allOpen = details.every((d) => (d as HTMLDetailsElement).open);
      details.forEach((d) => {
        (d as HTMLDetailsElement).open = !allOpen;
      });
      expandButton.textContent = allOpen ? "Expand all" : "Collapse all";
    });
  }
</script>

<style>
  .faq-answer a {
    color: var(--color-blue-500);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .faq-answer a:hover {
    color: var(--color-blue-600);
  }
  .faq-answer ul {
    margin-top: 0.75rem;
    list-style: disc;
    padding-left: 1.25rem;
  }
  .faq-answer li + li {
    margin-top: 0.25rem;
  }
  .faq-answer p + p {
    margin-top: 0.75rem;
  }
</style>
