---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for CVR Pilot, copy fetched live from https://attio.com/apps/cvr-pilot
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "cvr-pilot");
if (!app) throw new Error("Missing app detail: cvr-pilot");
---

<AppDetail app={app} />
