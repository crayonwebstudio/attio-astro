---
import BaseLayout from "../layouts/BaseLayout.astro";

// Shared layout for the three agentic-readiness result pages.
// Copy fetched live from https://attio.com/agentic-readiness/{foundations,orchestration,scaling}
// on 2026-11-16 (HTTP 200 each). The report cover is rebuilt as an HTML/CSS mock,
// no Attio images are hotlinked or copied. The report form has no backend: submit
// validates the email client side and shows the live success copy.

interface StepPart {
  text: string;
  href?: string;
}

interface Props {
  title: string;
  description: string;
  stage: string;
  heading: string;
  subcopy: string[];
  steps: StepPart[][];
}

const { title, description, stage, heading, subcopy, steps } = Astro.props;
---

<BaseLayout title={title} description={description} finalCtaDemo>
  <!-- Hero -->
  <section class="mx-auto max-w-[1200px] px-4 pt-16 pb-10 sm:px-6 sm:pt-24">
    <p class="text-sm font-semibold tracking-wide text-ink-600 uppercase">
      <a href="/agentic-readiness" class="hover:text-blue-500">Agentic readiness</a>
      <span aria-hidden="true"> / </span>
      {stage}
    </p>
    <h1 class="mt-4 max-w-[18em] font-display text-[40px] font-semibold leading-[1.05] tracking-tight text-balance sm:text-[56px]">
      {heading}
    </h1>
    {subcopy.map((para) => (
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-ink-600">{para}</p>
    ))}
  </section>

  <div class="mx-auto max-w-[1200px] px-4 sm:px-6" aria-hidden="true">
    <hr class="border-paper-500" />
  </div>

  <!-- Next steps + report form -->
  <section class="mx-auto max-w-[1200px] px-4 pb-24 pt-14 sm:px-6" aria-label="Your next steps">
    <div class="grid gap-12 lg:grid-cols-12">
      <div class="lg:col-span-7">
        <h2 class="font-display text-heading-md font-semibold tracking-tight text-balance">Your next steps</h2>
        <ol class="mt-10 flex max-w-xl list-decimal flex-col gap-6 pl-6 marker:font-semibold marker:text-ink-600 marker:tabular-nums">
          {steps.map((step) => (
            <li class="pl-1 text-pretty text-lg leading-relaxed text-ink-600">
              {step.map((part) =>
                part.href ? (
                  <a href={part.href} class="text-blue-500 underline underline-offset-2 hover:text-blue-600">
                    {part.text}
                  </a>
                ) : (
                  part.text
                )
              )}
            </li>
          ))}
        </ol>
        <div class="mt-10">
          <a
            href="/go/welcome/sign-in"
            class="inline-flex rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-400"
          >
            Explore Attio
          </a>
          <p class="mt-4 text-sm text-ink-600">
            <a href="/agentic-readiness" class="underline underline-offset-2 hover:text-blue-500">
              Retake the audit
            </a>
          </p>
        </div>
      </div>

      <!-- Report form -->
      <aside class="border-paper-500 bg-paper-200 p-8 lg:col-span-5 lg:border-l lg:p-10" aria-label="Get the full report">
        <div class="pinstripe-bg relative aspect-[4/5] w-full max-w-sm overflow-hidden rounded-xl bg-ink-50">
          <div class="absolute inset-0 flex flex-col items-start justify-between p-6 text-white">
            <p class="text-xs font-semibold uppercase tracking-[0.2em] text-white/70">Attio</p>
            <div>
              <p class="font-display text-2xl font-semibold leading-tight">The State of Agentic Sales, 2026</p>
              <p class="mt-2 text-sm text-white/70">The full report</p>
            </div>
          </div>
        </div>
        <h2 class="mt-8 font-display text-xl font-medium text-balance">Get the full report.</h2>
        <p class="mt-2 leading-relaxed text-ink-600">
          The State of Agentic Sales, 2026, sent straight to your inbox.
        </p>
        <form class="report-form mt-6" novalidate>
          <label for="report-email" class="sr-only">Your work email</label>
          <input
            id="report-email"
            name="companyEmail"
            type="email"
            placeholder="Your work email"
            autocomplete="email"
            class="w-full rounded-[10px] border border-paper-500 bg-white px-4 py-3 text-sm text-ink-100 placeholder:text-ink-700 focus:border-blue-500 focus:outline-none focus:ring-[3px] focus:ring-blue-300"
          />
          <p class="report-error mt-2 hidden text-sm font-medium text-red-500" role="alert">
            Please enter a valid email address
          </p>
          <button
            type="submit"
            class="mt-4 w-full rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-400"
          >
            Submit
          </button>
          <p class="mt-3 text-xs leading-relaxed text-ink-600">
            By submitting, you agree to receive marketing emails from Attio. You can unsubscribe at any
            time. See our
            <a href="/legal/privacy" class="underline underline-offset-2 hover:text-blue-500">Privacy Policy</a>.
          </p>
        </form>
        <div class="report-success hidden" role="status">
          <h3 class="font-display text-xl font-semibold">You&rsquo;re all set.</h3>
          <p class="mt-2 leading-relaxed text-ink-600">
            The State of Agentic Sales, 2026 is on its way to your inbox.
          </p>
        </div>
      </aside>
    </div>
  </section>

  <script>
    document.querySelectorAll(".report-form").forEach((form) => {
      form.addEventListener("submit", (e) => {
        e.preventDefault();
        const input = form.querySelector('input[name="companyEmail"]');
        const error = form.querySelector(".report-error");
        const value = input.value.trim();
        const valid = /^[^\s@]+@[^\s@]+\.[^\s@]{2,}$/.test(value);
        if (!valid) {
          error.classList.remove("hidden");
          input.focus();
          return;
        }
        error.classList.add("hidden");
        form.classList.add("hidden");
        const aside = form.closest("aside");
        aside.querySelector(".report-success").classList.remove("hidden");
      });
    });
  </script>
</BaseLayout>
