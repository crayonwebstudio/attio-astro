---
import BaseLayout from "../layouts/BaseLayout.astro";
import HelpSidebar from "./HelpSidebar.astro";

// Shared layout for the 38 Academy lesson pages under /help/academy/*.
// Copy fetched live from https://attio.com/help/academy/* on 2026-11-16
// (HTTP 200 each), stored in src/data/help.json. All titles, descriptions,
// lesson lists, durations, "What you will learn" items, and related
// articles are live Attio copy. Live em dashes are rendered as commas, per
// the no em dash rule. The lesson video is a YouTube video on live; the
// video file is not copied, the panel links out to the YouTube watch page.
// Live help pages have no standard FinalCta ("Agentic revenue runs on
// Attio." appears 0 times in the live HTML), so this layout hides the
// shared FinalCta. Progress is tracked client-side only, in localStorage;
// live tracks it per signed-in user, which this rebuild cannot do.

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const course = entry.course ?? {};
const lessons = course.lessons_list ?? [];
const crumbs = [
  ...(entry.breadcrumb ?? []),
  { t: course.title, href: `/help/academy/${entry.slug.split("/")[1]}` },
  { t: entry.h1, href: null },
];
const total = lessons.length || course.lessons || 0;
---

<BaseLayout title={`${entry.title} | Attio Help Center`} description={entry.description} hideFinalCta>
  <div class="mx-auto grid max-w-[1200px] lg:grid-cols-[260px_1fr]">
    <HelpSidebar current={entry.path} />

    <div class="min-w-0 px-4 pb-24 sm:px-6 lg:pl-10">
      <!-- Breadcrumb -->
      <nav class="flex h-9 flex-wrap items-center gap-1.5 pt-10 text-sm text-ink-600" aria-label="Breadcrumb">
        {crumbs.map((crumb: any, i: number) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {crumb.href ? (
              <a href={crumb.href} class="hover:text-blue-500 hover:underline">
                {crumb.t}
              </a>
            ) : (
              <span class="font-medium text-ink-100">{crumb.t}</span>
            )}
          </>
        ))}
      </nav>

      <!-- Video -->
      {entry.video && (
        <a
          href={`https://www.youtube.com/watch?v=${entry.video}`}
          target="_blank"
          rel="noopener noreferrer"
          class="pinstripe-bg relative mt-10 flex aspect-video w-full items-center justify-center overflow-hidden rounded-2xl bg-ink-50"
          aria-label={`Watch ${entry.h1} on YouTube`}
        >
          <span class="flex h-16 w-16 items-center justify-center rounded-full bg-white/90 text-xl font-bold text-ink-100" aria-hidden="true">
            ▶
          </span>
          <span class="absolute bottom-4 left-4 max-w-[80%] truncate rounded-lg bg-ink-50/80 px-3 py-1.5 text-sm font-semibold text-white">
            {entry.h1}
          </span>
        </a>
      )}

      <div class="grid gap-12 pt-12 xl:grid-cols-12">
        <div class="min-w-0 xl:col-span-8">
          <!-- Header -->
          <header>
            <h1 class="font-display text-[40px] font-semibold leading-[1.05] tracking-tight text-ink-100 sm:text-[56px]">
              {entry.h1}
            </h1>
            {entry.desc && (
              <p class="mt-6 max-w-[36em] text-lg leading-relaxed text-ink-600">{entry.desc}</p>
            )}
          </header>

          <!-- What you will learn -->
          {entry.learn && entry.learn.length > 0 && (
            <section class="mt-10 rounded-xl border border-paper-500 bg-paper-200 p-6" aria-label="What you will learn">
              <h2 class="font-display text-xl font-semibold text-ink-100">What you will learn</h2>
              <ul class="mt-4 space-y-3">
                {entry.learn.map((item: any) => (
                  <li class="leading-relaxed text-ink-100">
                    <strong class="font-semibold">{item.title}</strong>
                    <br />
                    <span class="text-ink-600">{item.copy}</span>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </div>

        <!-- Course panel -->
        <aside class="xl:col-span-4" aria-label="Course lessons">
          <div class="rounded-2xl border border-paper-500 bg-white p-6">
            <p class="font-display text-xl font-semibold text-ink-100">{course.title}</p>
            <p class="mt-1 text-sm text-ink-600">
              {total} lessons · Approx. {course.minutes} min
            </p>
            <div class="mt-6">
              <div class="flex items-center justify-between text-sm">
                <span class="font-semibold text-ink-100">Your progress</span>
                <span class="font-semibold text-ink-100" data-progress-label>0%</span>
              </div>
              <div class="mt-2 h-2 overflow-hidden rounded-full bg-paper-400">
                <div class="h-full rounded-full bg-blue-500 transition-all" style="width: 0%" data-progress-bar />
              </div>
            </div>
            <ol class="mt-6 space-y-1" data-lesson-list data-total={total}>
              {lessons.map((lesson: any) => (
                <li>
                  {lesson.current ? (
                    <div class="flex items-center justify-between gap-3 rounded-lg bg-paper-200 px-3 py-2">
                      <span class="min-w-0 text-sm font-semibold text-ink-100">{lesson.title}</span>
                      <span class="flex shrink-0 items-center gap-2 text-xs text-ink-600">
                        <span>{lesson.duration}</span>
                        <button
                          type="button"
                          data-mark-complete={entry.slug}
                          class="rounded-[10px] border border-paper-500 bg-white px-2.5 py-1 text-xs font-semibold text-ink-100 transition-colors hover:border-ink-800"
                        >
                          Mark as completed
                        </button>
                      </span>
                    </div>
                  ) : (
                    <a
                      href={lesson.href}
                      class="flex items-center justify-between gap-3 rounded-lg px-3 py-2 text-sm text-ink-600 transition-colors hover:bg-paper-200 hover:text-ink-100"
                      data-lesson-link={lesson.href}
                    >
                      <span class="min-w-0">{lesson.title}</span>
                      <span class="flex shrink-0 items-center gap-2 text-xs">
                        <span>{lesson.duration}</span>
                        <span>View</span>
                      </span>
                    </a>
                  )}
                </li>
              ))}
            </ol>
          </div>
        </aside>
      </div>

      <!-- Related articles -->
      {entry.related && entry.related.length > 0 && (
        <section class="mt-20" aria-label="Related articles">
          <h2 class="font-display text-[28px] font-semibold leading-tight tracking-tight sm:text-[32px]">
            Related articles
          </h2>
          <ul class="mt-10 grid gap-6 sm:grid-cols-2">
            {entry.related.map((rel: any) => (
              <li>
                <a
                  href={rel.href}
                  class="group flex h-full flex-col gap-1 overflow-hidden rounded-2xl border border-paper-500 bg-white p-6 transition-shadow hover:shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)]"
                >
                  <h3 class="font-display text-xl font-semibold tracking-tight text-ink-100">{rel.title}</h3>
                  <p class="mt-1 text-sm leading-relaxed text-ink-600">{rel.desc}</p>
                  <p class="mt-4 text-sm font-medium text-ink-700 transition-colors group-hover:text-ink-100">
                    Read more <span aria-hidden="true">→</span>
                  </p>
                </a>
              </li>
            ))}
          </ul>
        </section>
      )}

      <p class="mt-16 border-t border-dashed border-paper-600 pt-8">
        <a href="/help" class="text-sm font-semibold text-ink-100 underline underline-offset-4 hover:text-blue-500">
          Back to the Help Center
        </a>
      </p>
    </div>
  </div>

  <script>
    // Academy progress, client-side only in localStorage. Live tracks it per
    // signed-in user; this rebuild cannot do that.
    const KEY = "attio-academy-progress";
    function loadProgress() {
      try {
        return JSON.parse(localStorage.getItem(KEY) ?? "[]");
      } catch {
        return [];
      }
    }
    function saveProgress(done) {
      try {
        localStorage.setItem(KEY, JSON.stringify(done));
      } catch {
        // storage unavailable, progress stays in memory only
      }
    }
    const list = document.querySelector("[data-lesson-list]");
    const bar = document.querySelector("[data-progress-bar]");
    const label = document.querySelector("[data-progress-label]");
    const total = list ? Number(list.getAttribute("data-total") || 0) : 0;
    function renderProgress() {
      const done = loadProgress();
      const pct = total > 0 ? Math.round((done.length / total) * 100) : 0;
      if (bar) bar.style.width = pct + "%";
      if (label) label.textContent = pct + "%";
      document.querySelectorAll("[data-lesson-link]").forEach((link) => {
        const href = link.getAttribute("data-lesson-link") || "";
        const slug = href.replace(/^\/help\//, "");
        const view = link.querySelector("span:last-child");
        if (done.includes(slug) && view) view.textContent = "Completed";
      });
      document.querySelectorAll("[data-mark-complete]").forEach((button) => {
        const slug = button.getAttribute("data-mark-complete") || "";
        if (done.includes(slug)) {
          button.textContent = "Completed";
          button.setAttribute("disabled", "true");
        }
      });
    }
    document.querySelectorAll("[data-mark-complete]").forEach((button) => {
      button.addEventListener("click", () => {
        const slug = button.getAttribute("data-mark-complete") || "";
        const done = loadProgress();
        if (!done.includes(slug)) {
          done.push(slug);
          saveProgress(done);
        }
        button.textContent = "Completed";
        button.setAttribute("disabled", "true");
        renderProgress();
      });
    });
    renderProgress();
  </script>
</BaseLayout>
