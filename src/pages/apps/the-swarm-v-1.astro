---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for The Swarm, copy fetched live from https://attio.com/apps/the-swarm-v-1
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "the-swarm-v-1");
if (!app) throw new Error("Missing app detail: the-swarm-v-1");
---

<AppDetail app={app} />
