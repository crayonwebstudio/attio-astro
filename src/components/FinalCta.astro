---
/* Final CTA, black pinstripe section. Inverted pills versus the hero. */
interface Props {
  heading?: string;
  showDemo?: boolean;
}

const { heading = "Agentic revenue runs on Attio.", showDemo = false } = Astro.props;
---

<section class="pinstripe-bg bg-ink-50 text-white">
  <div class="mx-auto max-w-[1200px] px-4 py-24 text-center sm:px-6">
    <h2 class="font-display text-heading-md sm:text-heading-lg font-semibold tracking-tight">
      {heading}
    </h2>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/contact/sales"
        class="rounded-full bg-ink-500 px-6 py-3 text-sm font-semibold text-white ring-1 ring-white/20 hover:bg-ink-400"
      >
        Talk to sales
      </a>
      <a
        href="/go/welcome/sign-in"
        class="rounded-full bg-paper-300 px-6 py-3 text-sm font-semibold text-ink-100 hover:bg-white"
      >
        Start for free
      </a>
      {showDemo && (
        <a
          href="/contact/sales"
          class="rounded-full border border-white/40 px-6 py-3 text-sm font-semibold text-white hover:bg-white/10"
        >
          Send me a demo
        </a>
      )}
    </div>
  </div>
</section>
