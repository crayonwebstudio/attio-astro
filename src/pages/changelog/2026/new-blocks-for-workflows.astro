---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// New blocks for workflows, copy fetched live from https://attio.com/changelog/2026/new-blocks-for-workflows
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2026/new-blocks-for-workflows");
if (!entry) throw new Error("Missing changelog data for /changelog/2026/new-blocks-for-workflows");
---

<ChangelogEntry entry={entry} />
