---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Google Sheets, copy fetched live from https://attio.com/apps/google-sheets
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "google-sheets");
if (!app) throw new Error("Missing app detail: google-sheets");
---

<AppDetail app={app} />
