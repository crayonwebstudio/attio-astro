---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Veck, copy fetched live from https://attio.com/apps/veck
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "veck");
if (!app) throw new Error("Missing app detail: veck");
---

<AppDetail app={app} />
