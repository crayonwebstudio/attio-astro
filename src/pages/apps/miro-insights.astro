---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Miro Insights, copy fetched live from https://attio.com/apps/miro-insights
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "miro-insights");
if (!app) throw new Error("Missing app detail: miro-insights");
---

<AppDetail app={app} />
