---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Generate an API key, copy fetched live from https://attio.com/help/reference/apps/generating-an-api-key
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/apps/generating-an-api-key");
if (!entry) throw new Error("Missing help data for reference/apps/generating-an-api-key");
---

<HelpArticle entry={entry} />
