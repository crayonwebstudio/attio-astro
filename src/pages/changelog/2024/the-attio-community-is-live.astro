---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// The Attio Community is live, copy fetched live from https://attio.com/changelog/2024/the-attio-community-is-live
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2024/the-attio-community-is-live");
if (!entry) throw new Error("Missing changelog data for /changelog/2024/the-attio-community-is-live");
---

<ChangelogEntry entry={entry} />
