---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Civic IQ, copy fetched live from https://attio.com/apps/civic-iq
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "civic-iq");
if (!app) throw new Error("Missing app detail: civic-iq");
---

<AppDetail app={app} />
