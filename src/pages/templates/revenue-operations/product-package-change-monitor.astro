---
import WorkflowTemplate from "../../../components/WorkflowTemplate.astro";
import templates from "../../../data/templates.json";

// Product package change monitor, copy fetched live from https://attio.com/templates/revenue-operations/product-package-change-monitor
// on 2026-11-17 (HTTP 200). Data lives in src/data/templates.json.
const entry = (templates as any[]).find((entry) => entry.path === "/templates/revenue-operations/product-package-change-monitor");
if (!entry) throw new Error("Missing template data for /templates/revenue-operations/product-package-change-monitor");
---

<WorkflowTemplate entry={entry} />
