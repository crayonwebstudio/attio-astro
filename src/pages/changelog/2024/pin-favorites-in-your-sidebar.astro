---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Pin favorites in your sidebar, copy fetched live from https://attio.com/changelog/2024/pin-favorites-in-your-sidebar
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2024/pin-favorites-in-your-sidebar");
if (!entry) throw new Error("Missing changelog data for /changelog/2024/pin-favorites-in-your-sidebar");
---

<ChangelogEntry entry={entry} />
