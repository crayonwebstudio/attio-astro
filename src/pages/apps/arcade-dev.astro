---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Arcade.dev, copy fetched live from https://attio.com/apps/arcade-dev
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "arcade-dev");
if (!app) throw new Error("Missing app detail: arcade-dev");
---

<AppDetail app={app} />
