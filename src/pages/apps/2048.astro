---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for 2048 Game Arcade, copy fetched live from https://attio.com/apps/2048
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "2048");
if (!app) throw new Error("Missing app detail: 2048");
---

<AppDetail app={app} />
