---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Calendly, copy fetched live from https://attio.com/apps/calendly-events
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "calendly-events");
if (!app) throw new Error("Missing app detail: calendly-events");
---

<AppDetail app={app} />
