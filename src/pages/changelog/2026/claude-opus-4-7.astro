---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Claude Opus 4.7, copy fetched live from https://attio.com/changelog/2026/claude-opus-4-7
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2026/claude-opus-4-7");
if (!entry) throw new Error("Missing changelog data for /changelog/2026/claude-opus-4-7");
---

<ChangelogEntry entry={entry} />
