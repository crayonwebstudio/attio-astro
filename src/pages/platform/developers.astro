---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Copy fetched live from https://attio.com/platform/developers on 2026-11-16 (HTTP 200).
// Product visuals are rebuilt as HTML/CSS mocks, no Attio images are hotlinked or copied.
// Live H1 is "Developer Platform", used as the eyebrow, with the headline H2
// "Dream. Code. Ship." as the single H1, same pattern as /platform/data and /platform/mcp.
// Live images: nick-janes.png and will-stenzel.png are quote portraits; aircall-,
// granola-, linear-, pandadoc- and sequence-for-developers.png sit on the 5 app cards;
// og-developer-platform-2.png is meta only, not a page image.
// Destinations verified from the live DOM: REST API docs
// https://docs.attio.com/rest-api/overview, App SDK docs
// https://docs.attio.com/sdk/guides/creating-an-app, MCP docs
// https://docs.attio.com/mcp/overview, "How we build" to /engineering/blog,
// Linear app on GitHub https://github.com/attio/linear-app.
// "programatically" is Attio's own spelling on the live page, kept verbatim.

const restItems = [
  { n: "01", title: "Create custom integrations with full read and write access." },
  { n: "02", title: "Listen for webhooks and take action programatically." },
  { n: "03", title: "Authenticate and authorize access with OAuth 2.0." },
];

const sdkItems = [
  { n: "01", title: "Choose entry points like record actions, widgets, or text selection to run your app inside Attio." },
  { n: "02", title: "Create forms and define the shape and validation rules of your form data." },
  { n: "03", title: "Use server functions to fetch, update, or remove data from third parties." },
  { n: "04", title: "Authenticate connections for users or entire workspaces between Attio and external parties." },
  { n: "05", title: "Receive external requests with webhooks to sync Attio or respond with data." },
  { n: "06", title: "Add ready-made UI components to ship polished interfaces for your app." },
];

const mcpItems = [
  { n: "01", title: "Enable agent-driven workflows with full read and write access." },
  { n: "02", title: "Search, create, and manage data in Attio through structured tool calls." },
  { n: "03", title: "Reason across Attio and other systems with dynamic, multi-tool execution." },
  { n: "04", title: "Authenticate securely via OAuth with user-scoped permissions." },
  { n: "05", title: "Connect in any MCP client alongside any other MCP servers." },
];

const apps = [
  { name: "Aircall", slug: "aircall", glyph: "Ai" },
  { name: "Granola", slug: "granola", glyph: "Gr" },
  { name: "Linear", slug: "linear", glyph: "Li" },
  { name: "Pandadoc", slug: "pandadoc", glyph: "Pa" },
  { name: "Sequence", slug: "sequence", glyph: "Se" },
];
---

<BaseLayout
  title="Developer Platform | Attio"
  description="Attio is the CRM for developers."
  finalCtaDemo
>
  <!-- Hero -->
  <section class="mx-auto max-w-[1200px] px-4 pb-12 pt-16 text-center sm:px-6 sm:pt-24">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-500">Developer Platform</p>
    <h1 class="mx-auto mt-6 max-w-4xl font-display text-[56px] font-semibold leading-[1.05] tracking-tight sm:text-[72px]">
      Dream. Code. Ship.
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 sm:text-xl">
      Connect your GTM stack with the REST API, App SDK, or Attio MCP.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="https://docs.attio.com"
        class="rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        View docs
      </a>
      <a
        href="/apps"
        class="rounded-full border border-ink-100 px-6 py-3 text-sm font-semibold text-ink-100 hover:bg-paper-200"
      >
        Browse apps
      </a>
    </div>

    <!-- Hero mock: three ways to build on Attio -->
    <div class="mx-auto mt-14 max-w-3xl overflow-hidden rounded-2xl border border-paper-500 bg-white text-left shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)]">
      <div class="flex items-center gap-2 border-b border-paper-400 bg-paper-200 px-4 py-3">
        <span class="h-3 w-3 rounded-full bg-red-500"></span>
        <span class="h-3 w-3 rounded-full bg-[#f5bf42]"></span>
        <span class="h-3 w-3 rounded-full bg-green-500"></span>
        <span class="ml-3 text-xs font-medium text-ink-600">developer-platform</span>
        <span class="ml-auto rounded-full bg-ink-100 px-3 py-1 font-mono text-xs text-white">TypeScript</span>
      </div>
      <ul class="divide-y divide-paper-400">
        <li class="flex items-baseline gap-3 px-6 py-4">
          <span class="font-mono text-sm font-semibold text-blue-500">REST API</span>
          <span class="text-sm text-ink-600">Create custom integrations with full read and write access.</span>
        </li>
        <li class="flex items-baseline gap-3 px-6 py-4">
          <span class="font-mono text-sm font-semibold text-blue-500">App SDK</span>
          <span class="text-sm text-ink-600">Extend Attio in TypeScript and React.</span>
        </li>
        <li class="flex items-baseline gap-3 px-6 py-4">
          <span class="font-mono text-sm font-semibold text-blue-500">Attio MCP</span>
          <span class="text-sm text-ink-600">Expose Attio to AI clients.</span>
        </li>
      </ul>
    </div>
  </section>

  <!-- Integrate Attio with anything -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Integrate Attio with anything">
    <h2 class="max-w-2xl font-display text-heading-md font-semibold tracking-tight">
      Integrate Attio with anything.
    </h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      Start coding with a simple REST API that is secure and built for scale.
    </p>
    <p class="mt-6">
      <a
        href="https://docs.attio.com/rest-api/overview"
        class="text-sm font-semibold text-blue-500 underline underline-offset-4 hover:text-blue-600"
      >
        View docs
      </a>
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {restItems.map((item) => (
        <article class="rounded-2xl border border-paper-500 bg-white p-6">
          <p class="font-display text-sm font-semibold text-blue-500">{item.n}</p>
          <h3 class="mt-2 font-display text-xl font-semibold">{item.title}</h3>
        </article>
      ))}
    </div>

    <!-- Nick Janes quote -->
    <blockquote class="mx-auto mt-16 max-w-3xl text-center font-serif text-2xl leading-snug text-ink-100 sm:text-3xl">
      I am drawn to tools that believe in the builder economy, platforms that give you Lego blocks
      instead of rigid software. The Attio SDK gives the authority and autonomy back to builders.
    </blockquote>
    <p class="mt-6 text-center text-sm font-semibold">Nick Janes</p>
    <p class="mt-1 text-center text-sm text-ink-600">Attio Partner</p>
  </section>

  <!-- Build your Attio, your way -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Build your Attio, your way">
    <h2 class="max-w-2xl font-display text-heading-md font-semibold tracking-tight">
      Build your Attio, your way.
    </h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      Extend Attio in TypeScript and React with the App SDK.
    </p>
    <p class="mt-6">
      <a
        href="https://docs.attio.com/sdk/guides/creating-an-app"
        class="text-sm font-semibold text-blue-500 underline underline-offset-4 hover:text-blue-600"
      >
        View docs
      </a>
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {sdkItems.map((item) => (
        <article class="rounded-2xl border border-paper-500 bg-white p-6">
          <p class="font-display text-sm font-semibold text-blue-500">{item.n}</p>
          <h3 class="mt-2 font-display text-xl font-semibold">{item.title}</h3>
        </article>
      ))}
    </div>

    <!-- Kacper Cygan quote -->
    <blockquote class="mx-auto mt-16 max-w-3xl text-center font-serif text-2xl leading-snug text-ink-100 sm:text-3xl">
      I really wanted to work with something hyper modern, the Attio SDK gives me that.
    </blockquote>
    <p class="mt-6 text-center text-sm font-semibold">Kacper Cygan</p>
    <p class="mt-1 text-center text-sm text-ink-600">sequence</p>
  </section>

  <!-- Expose Attio to AI clients -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Expose Attio to AI clients">
    <h2 class="max-w-2xl font-display text-heading-md font-semibold tracking-tight">
      Expose Attio to AI clients.
    </h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      Use the MCP server with coding agents, automation tools, or to integrate with your product.
    </p>
    <p class="mt-6">
      <a
        href="https://docs.attio.com/mcp/overview"
        class="text-sm font-semibold text-blue-500 underline underline-offset-4 hover:text-blue-600"
      >
        View docs
      </a>
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {mcpItems.map((item) => (
        <article class="rounded-2xl border border-paper-500 bg-white p-6">
          <p class="font-display text-sm font-semibold text-blue-500">{item.n}</p>
          <h3 class="mt-2 font-display text-xl font-semibold">{item.title}</h3>
        </article>
      ))}
    </div>

    <!-- Siavash Ghorbani quote -->
    <blockquote class="mx-auto mt-16 max-w-3xl text-center font-serif text-2xl leading-snug text-ink-100 sm:text-3xl">
      The Attio MCP gave us instant access to Attio's full data model without custom API work.
    </blockquote>
    <p class="mt-6 text-center text-sm font-semibold">Siavash Ghorbani</p>
    <p class="mt-1 text-center text-sm text-ink-600">Stilla</p>
  </section>

  <!-- For developers, by developers -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 text-center sm:px-6" aria-label="For developers, by developers">
    <h2 class="mx-auto max-w-2xl font-display text-heading-md font-semibold tracking-tight">
      For developers, by developers.
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      We use what we build and commit to it daily.
    </p>
    <p class="mt-6">
      <a
        href="/engineering/blog"
        class="text-sm font-semibold text-blue-500 underline underline-offset-4 hover:text-blue-600"
      >
        How we build
      </a>
    </p>
    <p class="mt-10 font-display text-[72px] font-semibold leading-none tracking-tight sm:text-[100px]">14,810</p>
    <p class="mt-4 text-lg text-ink-600">pull requests merged in the past year</p>

    <!-- Will Stenzel quote -->
    <blockquote class="mx-auto mt-16 max-w-3xl font-serif text-2xl leading-snug text-ink-100 sm:text-3xl">
      With the SDK, backend logic and frontend UI are seamlessly connected. It is a joy to work with.
    </blockquote>
    <p class="mt-6 text-sm font-semibold">Will Stenzel</p>
    <p class="mt-1 text-sm text-ink-600">Attio Partner</p>
  </section>

  <!-- The SDK behind fast, flawless apps -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="The SDK behind fast, flawless apps">
    <h2 class="max-w-2xl font-display text-heading-md font-semibold tracking-tight">
      The SDK behind fast, flawless apps.
    </h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      Leading teams are already building with the App SDK. Share apps internally or publish to the
      App Store.
    </p>
    <p class="mt-6">
      <a
        href="/apps"
        class="rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Browse apps
      </a>
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {apps.map((app) => (
        <a
          href={`/apps/${app.slug}`}
          class="block rounded-2xl border border-paper-500 bg-white p-6 text-center hover:border-blue-500"
        >
          <span class="mx-auto flex h-12 w-12 items-center justify-center rounded-xl bg-paper-200 font-display text-lg font-semibold text-ink-100">
            {app.glyph}
          </span>
          <span class="mt-4 block font-display text-lg font-semibold">{app.name}</span>
        </a>
      ))}
    </div>
    <p class="mt-10 text-center">
      <a
        href="https://github.com/attio/linear-app"
        class="text-sm font-semibold text-blue-500 underline underline-offset-4 hover:text-blue-600"
      >
        See our open source Linear app on GitHub
      </a>
    </p>
  </section>

  <!-- Ready to build -->
  <section class="mx-auto max-w-[1200px] px-4 pb-24 sm:px-6" aria-label="Ready to build">
    <h2 class="max-w-2xl font-display text-heading-md font-semibold tracking-tight">Ready to build?</h2>
    <div class="mx-auto mt-10 max-w-3xl overflow-hidden rounded-2xl border border-paper-500 bg-white text-left shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)]">
      <div class="flex items-center gap-3 border-b border-paper-400 bg-paper-200 px-4 py-3">
        <span class="h-3 w-3 rounded-full bg-red-500"></span>
        <span class="h-3 w-3 rounded-full bg-[#f5bf42]"></span>
        <span class="h-3 w-3 rounded-full bg-green-500"></span>
        <a href="https://docs.attio.com/sdk/" class="ml-2 flex-1 truncate rounded-lg bg-white px-4 py-2 font-mono text-sm text-ink-600 shadow-sm">
          https://docs.attio.com/sdk/
        </a>
        <button
          type="button"
          data-docs-toggle
          aria-label="Toggle docs view"
          class="relative h-6 w-11 shrink-0 rounded-full bg-blue-500 transition-colors"
        >
          <span data-docs-knob class="absolute left-0.5 top-0.5 h-5 w-5 rounded-full bg-white shadow transition-transform"></span>
        </button>
      </div>
      <div class="p-6 sm:p-8">
        <p class="text-sm leading-relaxed text-ink-600">
          Start with the App SDK docs, then ship your first app to the App Store.
        </p>
        <p class="mt-4">
          <a
            href="https://docs.attio.com/sdk/"
            class="rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
          >
            View docs
          </a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // "Ready to build?" toggle: slides the knob, same mock behaviour as the live toggle.
  const toggle = document.querySelector("[data-docs-toggle]");
  const knob = document.querySelector("[data-docs-knob]");
  if (toggle && knob) {
    toggle.addEventListener("click", () => {
      const on = toggle.getAttribute("aria-pressed") === "true";
      toggle.setAttribute("aria-pressed", String(!on));
      toggle.classList.toggle("bg-blue-500", !on);
      toggle.classList.toggle("bg-paper-500", on);
      knob.style.transform = on ? "translateX(0)" : "translateX(20px)";
    });
  }
</script>
