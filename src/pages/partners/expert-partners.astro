---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PartnersFaq from "../../components/PartnersFaq.astro";
import PartnersPathways from "../../components/PartnersPathways.astro";

// Copy fetched live from https://attio.com/partners/expert-partners on 2026-11-16
// (HTTP 200, 583KB).
// Product visuals are rebuilt as HTML/CSS mocks, no Attio images are hotlinked or copied.
// Live has no standard FinalCta ("Agentic revenue runs on Attio." appears 0 times
// in the live HTML), so hideFinalCta is used.
// Live H1 is the small pill ("Expert partners"); the large hero headline is an H2,
// as on live.
// The application form on live is a Typeform embed (formId qSjFNw9I, verified from
// the live page payload). It is NOT embedded here: the form would submit real data
// to Attio's Typeform. The section renders the live heading and subcopy with a
// button linking out to the live form URL instead, and no data is sent from this site.

const experts = [
  "Alfie", "Alex", "Nacho", "Alex", "Joe", "Will", "Kayla", "Jason", "Giacomo",
  "Daniel", "Ben", "George", "Luke", "Nick", "Marco", "Nick", "Maxime",
];

const lookingFor = [
  { title: "Attio power users", body: "Masters of every Attio feature." },
  { title: "CRM architects", body: "Builders of bespoke Attio implementations." },
  { title: "GTM strategists", body: "Designers of GTM motions driving growth." },
  { title: "Onboarding pros", body: "Drivers of client journeys from setup to adoption." },
  { title: "Automation engineers", body: "Creators of workflows and integrations." },
];

const tiers = [
  {
    n: "01",
    title: "Core",
    benefits: ["Revenue share.", "Expert access.", "Expert workspace.", "Experts Directory listing.", "Private Experts community."],
  },
  {
    n: "02",
    title: "Advanced",
    benefits: ["All Core benefits.", "Experts slack group.", "Quarterly business reviews.", "Early access to Attio alphas.", "Attio team recommendations."],
  },
  {
    n: "03",
    title: "Elite",
    benefits: ["All Advanced benefits.", "Private slack channel.", "Sales team workshops.", "Co-marketing opportunities.", "Dedicated solutions engineer."],
  },
];

const pathSteps = [
  { title: "Application form", body: "Share what excites you about working with Attio, your unique experience, and your skills." },
  { title: "Skills presentation", body: "Walk through your Attio customer work or complete our case study project." },
  { title: "Onboarding call", body: "Meet the team and learn how to succeed as an Attio Expert." },
  { title: "Experts Directory", body: "Get listed in our Directory and be discovered by customers." },
];

const resources = [
  { title: "Help Center", body: "Learn in detail about all of Attio's features and capabilities in one place.", href: "/help" },
  { title: "Attio Academy", body: "Learn how to build powerful GTM systems in Attio with our in-depth video course.", href: "/help/academy" },
  { title: "Attio Community", body: "Connect with builders, get access to best-practice workshops and keep up to speed.", href: "https://www.attio.community/feed" },
];

const faq = [
  {
    q: "Who is the Experts partner program for?",
    a: "The Experts program is for consultants, agencies, and operators who regularly help companies implement their CRM and RevOps workflows.",
  },
  {
    q: "What's expected of Experts?",
    a: "Experts are expected to stay up to date with the product, represent Attio accurately, and prioritise client outcomes. There are no sales quotas, but we do expect partners to be actively using and recommending Attio where it's a good fit.",
  },
  {
    q: "What's the difference between Experts, Creators, and App Developers?",
    a: "<p>Each program is designed for a different way of working with Attio:</p><ul><li>Experts work directly with clients to implement and advise on Attio.</li><li>Creators focus on content, education, and audience-building around Attio.</li><li>App Developers build and maintain apps or integrations that extend Attio's functionality.</li></ul><p>If you primarily deliver client services, the Experts program is the right fit.</p>",
  },
  {
    q: "Is this a reseller or affiliate program?",
    a: "No. The Experts program is not a traditional reseller or affiliate program. It's designed for hands-on experts who actively work with clients and support the Attio team.",
  },
  {
    q: "Can I be part of more than one program?",
    a: "Potentially, yes. If you operate across multiple areas, for example, you consult with clients and also build apps or create educational content, we'll work with you to determine the best setup.",
  },
];
---

<BaseLayout
  title="Experts Partner Program | Attio"
  description="Provide your services to activate Attio customers. Get exclusive perks and resources to establish your business."
  hideFinalCta
>
  <!-- Hero -->
  <section class="mx-auto max-w-[1200px] px-4 pb-16 pt-16 text-center sm:px-6 sm:pt-24">
    <div class="mx-auto w-fit rounded-[13px] border border-paper-500 bg-white px-3 py-1.5 text-[13px] font-medium leading-[1.4em] text-ink-600">
      <h1 class="font-medium">Expert partners</h1>
    </div>
    <h2 class="mx-auto mt-6 max-w-[15em] text-balance font-display text-[56px] font-semibold leading-[1.05] tracking-tight sm:text-[72px]">
      Build go-to-market magic.
    </h2>
    <p class="mx-auto mt-6 max-w-xl text-balance text-lg leading-relaxed text-ink-600 sm:text-xl">
      Help the next generation of companies scale and grow their businesses to the next level.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="#expert-partners-form"
        class="inline-flex items-center gap-1.5 rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Become an Expert partner
      </a>
      <a
        href="https://attio.com/experts"
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-1.5 rounded-full border border-paper-500 bg-white px-6 py-3 text-sm font-semibold text-ink-100 hover:border-ink-800"
      >
        Hire an Expert
      </a>
    </div>

    <!-- Expert photo collage mock: initials tiles, live photos not copied -->
    <div class="mx-auto mt-14 grid max-w-4xl grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-6">
      {
        experts.map((name, i) => (
          <div class="flex min-h-[110px] flex-col items-center justify-center gap-1 rounded-2xl border border-paper-500 bg-white px-2 py-4 text-center">
            <span class="flex h-10 w-10 items-center justify-center rounded-full bg-ink-100 font-display text-sm font-semibold text-white">
              {name.slice(0, 2)}
            </span>
            <span class="text-sm font-medium text-ink-100">{name}</span>
            <span class="sr-only">Expert {i + 1}</span>
          </div>
        ))
      }
      <div class="pinstripe-bg flex min-h-[110px] flex-col items-center justify-center gap-1 rounded-2xl bg-ink-100 px-2 py-4 text-center">
        <span class="font-display text-lg font-semibold text-white">attio</span>
        <span class="text-xs text-white/70">Experts Directory</span>
      </div>
    </div>
  </section>

  <!-- Who we're looking for -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Who we are looking for">
    <div class="text-center">
      <h2 class="font-display text-heading-md font-semibold tracking-tight">Who we&rsquo;re looking for.</h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
        Builders ready to shape the future of CRM.
      </p>
    </div>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-5">
      {
        lookingFor.map((item) => (
          <div class="rounded-2xl border border-paper-500 bg-white p-6">
            <h3 class="font-display text-xl font-semibold tracking-tight text-ink-100">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.body}</p>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Tiers -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Rise through the tiers">
    <div class="text-center">
      <h2 class="font-display text-heading-md font-semibold tracking-tight">Rise through the tiers.</h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
        Start at Core, grow into Advanced, and build your way to Elite.
      </p>
    </div>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        tiers.map((tier) => (
          <div class="rounded-2xl border border-paper-500 bg-white p-8">
            <p class="font-display text-sm font-semibold text-ink-700">/ {tier.n}</p>
            <h3 class="mt-3 font-display text-heading-xs font-semibold tracking-tight text-ink-100">{tier.title}</h3>
            <ul class="mt-5 space-y-2.5">
              {
                tier.benefits.map((b) => (
                  <li class="flex items-start gap-2.5 text-base leading-relaxed text-ink-600">
                    <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500" aria-hidden="true" />
                    {b}
                  </li>
                ))
              }
            </ul>
          </div>
        ))
      }
    </div>
    <div class="mt-10 text-center">
      <p class="font-display text-heading-xs font-semibold tracking-tight text-ink-100">Your benefits are waiting.</p>
      <p class="mt-2 text-base leading-relaxed text-ink-600">
        Talk to our team to discover more about the program.
      </p>
      <a
        href="#expert-partners-form"
        class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Become an Expert
      </a>
    </div>
  </section>

  <!-- Path to the Experts Directory -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Your path to the Experts Directory">
    <div class="text-center">
      <h2 class="font-display text-heading-md font-semibold tracking-tight">Your path to the Experts Directory.</h2>
      <p class="mx-auto mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
        Four steps to join the Attio Experts community.
      </p>
    </div>
    <ol class="mx-auto mt-12 grid max-w-4xl gap-6 sm:grid-cols-2">
      {
        pathSteps.map((step, i) => (
          <li class="rounded-2xl border border-paper-500 bg-white p-8">
            <p class="font-display text-sm font-semibold text-ink-700">0{i + 1} /</p>
            <h3 class="mt-3 font-display text-heading-xs font-semibold tracking-tight text-ink-100">{step.title}</h3>
            <p class="mt-3 text-base leading-relaxed text-ink-600">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <p class="mt-8 text-center">
      <a
        href="#expert-partners-form"
        class="inline-flex items-center gap-1.5 rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Apply now
      </a>
    </p>
  </section>

  <!-- Application form -->
  <section id="expert-partners-form" class="bg-paper-200" aria-label="Become an Attio Expert partner">
    <div class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6">
      <div class="grid gap-10 lg:grid-cols-2 lg:items-center">
        <div>
          <h2 class="font-display text-heading-md font-semibold tracking-tight">Become an Attio Expert partner.</h2>
          <p class="mt-3 max-w-xl text-lg leading-relaxed text-ink-600">
            Reach out to our partnerships team.
          </p>
        </div>
        <div class="rounded-2xl border border-paper-500 bg-white p-8 text-center">
          <p class="font-display text-xl font-semibold tracking-tight text-ink-100">Expert partner application</p>
          <p class="mx-auto mt-3 max-w-md text-base leading-relaxed text-ink-600">
            Tell us about your experience and how you work with Attio customers. The application form opens on
            Attio&rsquo;s application page.
          </p>
          <a
            href="https://form.typeform.com/to/qSjFNw9I"
            target="_blank"
            rel="noopener noreferrer"
            class="mt-6 inline-flex items-center gap-1.5 rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
          >
            Open the application form
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Resources -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 pt-20 sm:px-6" aria-label="Be an expert at your craft">
    <h2 class="font-display text-heading-md font-semibold tracking-tight">Be an expert at your craft.</h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      See the resources you need to become an Attio Expert.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {
        resources.map((item) => (
          <a
            href={item.href}
            class="group rounded-2xl border border-paper-500 bg-white p-8 transition-colors hover:bg-paper-200"
          >
            <h3 class="font-display text-xl font-semibold group-hover:underline">{item.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.body}</p>
          </a>
        ))
      }
    </div>
  </section>

  <PartnersFaq items={faq} />

  <PartnersPathways
    title="Join the builders redefining CRM."
    subtitle="Whether you're building apps or growing an audience, there's a partner path for you."
    cards={[
      {
        href: "/partners/app-partners",
        label: "App partners",
        title: "App partners.",
        subtitle: "Build apps that power the next era of CRM.",
        link: "Become an App partner",
      },
      {
        href: "/partners/creator-partners",
        label: "Creator partners",
        title: "Creator partners.",
        subtitle: "Build your brand and grow your audience.",
        link: "Become a Creator partner",
      },
    ]}
  />
</BaseLayout>
