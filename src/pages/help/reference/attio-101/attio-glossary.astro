---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Attio glossary, copy fetched live from https://attio.com/help/reference/attio-101/attio-glossary
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/attio-101/attio-glossary");
if (!entry) throw new Error("Missing help data for reference/attio-101/attio-glossary");
---

<HelpArticle entry={entry} />
