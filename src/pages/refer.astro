---
import BaseLayout from "../layouts/BaseLayout.astro";
import PartnersFaq from "../components/PartnersFaq.astro";

// Copy fetched live from https://attio.com/refer on 2026-11-17 (HTTP 200).
// Live has no standard FinalCta ("Agentic revenue runs on Attio." appears 0
// times in the live HTML), so hideFinalCta is used. The 12 customer logos are
// rendered as text wordmarks, not copied images. "Start referring" and "Get my
// shareable link" both link to /go/_/settings/referrals, as on live.
const faqs = [
  {
    q: "What is the Referral Program?",
    a: "<p>Refer your friend to Attio Pro / Ultra and you\u2019ll get a $200 gift card for every valid referral. Your referral gets 10% off their first year on a paid plan.</p>",
  },
  {
    q: "Are there any terms and conditions I should be aware of?",
    a: "<p>Please refer to our <a href=\"/legal/referral-gift-card-reward-policy\">Referral Gift Card Policy</a> for more detail.</p>",
  },
  {
    q: "What counts as a valid referral?",
    a: "<p>A referral is considered valid when a new workspace meets all of the following:</p><ul><li>Signs up to Attio using your referral link.</li><li>Upgrades to a paid Pro or Ultra plan within 60 days of signing up.</li><li>Remains on a paid Pro or Ultra plan for three consecutive months following their two-week trial. Any cancellation, downgrade to a non-qualifying plan, or workspace deletion during the three-month paid period will disqualify the referral.</li></ul>",
  },
  {
    q: "What do I get?",
    a: "<p>For every valid referral, you\u2019ll receive a $200 digital gift card, delivered via email to the address associated with your Attio account. We\u2019ll send it to you within 30 days of your referral completing the 3-month qualifying period.</p>",
  },
  {
    q: "Can referral rewards be combined with other offers?",
    a: "<p>No. Referral rewards, both the gift card and the 10% discount, cannot be combined with any other promotional or incentive offers, including but not limited to: startup program discount, sales offers, and any other special promos. The reward applies only to new workspaces that sign up using your link.</p>",
  },
  {
    q: "I've referred someone but haven't got my gift card - why?",
    a: "<p>The most common reasons why you haven\u2019t received a gift-card are: the 3-month qualifying period hasn\u2019t elapsed yet, your referral didn\u2019t sign up using your unique link, the referral didn't convert to Pro/Ultra within 60 days of signing up, or the referred workspace has cancelled, deleted, or downgraded to the Free or Plus plan after their first paid date.</p>",
  },
];

const logos = [
  "Granola",
  "Wispr Flow",
  "Listen Labs",
  "Obvious",
  "Modal",
  "Union Square Ventures",
  "Replicate",
  "Railway",
  "Taskrabbit",
  "Public",
  "Wordsmith",
  "Passionfroot",
];

const steps = [
  {
    n: "01",
    title: "Share your unique link",
    body: "Your referrals get 10% off their first year of Attio Pro or Ultra when they sign up with your referral link.",
  },
  {
    n: "02",
    title: "Your referral uses Attio",
    body: "Your referral converts to Attio Pro or Ultra within 60 days of signing up, and stays on the plan for 3 consecutive months.",
  },
  {
    n: "03",
    title: "Receive your reward",
    body: "Once your referral has been on Pro or Ultra for 3 months, we'll send you a $200 digital gift card via our reward provider.",
  },
];
---

<BaseLayout
  title="Referral Program | Attio"
  description="Get $200 for every valid referral you make. Terms and conditions apply."
  hideFinalCta
>
  <!-- Hero -->
  <section class="mx-auto max-w-[1200px] px-4 pb-16 pt-16 text-center sm:px-6 sm:pt-24">
    <h1 class="mx-auto max-w-3xl font-display text-[56px] font-semibold leading-[1.05] tracking-tight sm:text-[72px]">
      Refer and earn $200.
    </h1>
    <p class="mx-auto mt-6 max-w-xl text-lg leading-relaxed text-ink-600 sm:text-xl">
      Get $200 for every valid referral you make. Terms and conditions apply.*
    </p>
    <div class="mt-8">
      <a
        href="/go/_/settings/referrals"
        class="inline-block rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Start referring
      </a>
    </div>
    <!-- Logo strip: text wordmarks in live order, live logos not copied -->
    <div class="mx-auto mt-16 flex max-w-4xl flex-wrap items-center justify-center gap-x-8 gap-y-4 text-lg font-semibold text-ink-700">
      {logos.map((logo) => <span>{logo}</span>)}
    </div>
  </section>

  <!-- How it works -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="How it works">
    <h2 class="font-display text-heading-md font-semibold tracking-tight">How it works.</h2>
    <p class="mt-4 max-w-2xl text-lg leading-relaxed text-ink-600">
      Participate in the Referral Program in a few simple steps.
    </p>
    <ol class="mt-10 grid gap-6 md:grid-cols-3">
      {
        steps.map((step) => (
          <li class="rounded-2xl border border-paper-500 bg-white p-8">
            <p class="font-display text-sm font-semibold text-blue-500">{step.n}</p>
            <h3 class="mt-3 font-display text-2xl font-semibold tracking-tight">{step.title}</h3>
            <p class="mt-3 leading-relaxed text-ink-600">{step.body}</p>
          </li>
        ))
      }
    </ol>
    <div class="mt-10">
      <a
        href="/go/_/settings/referrals"
        class="inline-block rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Start referring
      </a>
    </div>
  </section>

  <!-- FAQ -->
  <PartnersFaq items={faqs} />

  <!-- Closing -->
  <section class="mx-auto max-w-[1200px] px-4 pb-24 text-center sm:px-6" aria-label="Start referring today">
    <h2 class="font-display text-heading-md font-semibold tracking-tight">Start referring today.</h2>
    <div class="mt-8">
      <a
        href="/go/_/settings/referrals"
        class="inline-block rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Get my shareable link
      </a>
    </div>
  </section>
</BaseLayout>
