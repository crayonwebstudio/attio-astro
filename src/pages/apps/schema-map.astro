---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Schema Map, copy fetched live from https://attio.com/apps/schema-map
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "schema-map");
if (!app) throw new Error("Missing app detail: schema-map");
---

<AppDetail app={app} />
