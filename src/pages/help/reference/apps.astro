---
import HelpCategory from "../../../components/HelpCategory.astro";
import help from "../../../data/help.json";

// Apps, copy fetched live from https://attio.com/help/reference/apps
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/apps");
if (!entry) throw new Error("Missing help data for reference/apps");
---

<HelpCategory entry={entry} />
