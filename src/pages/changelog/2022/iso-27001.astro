---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// ISO 27001, copy fetched live from https://attio.com/changelog/2022/iso-27001
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2022/iso-27001");
if (!entry) throw new Error("Missing changelog data for /changelog/2022/iso-27001");
---

<ChangelogEntry entry={entry} />
