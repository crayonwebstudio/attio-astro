---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Introducing Attio Automations: The engine for your GTM team, copy fetched live from https://attio.com/blog/introducing-attio-automations
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "introducing-attio-automations");
if (!post) throw new Error("Missing post data for introducing-attio-automations");
---

<BlogPost post={post} />
