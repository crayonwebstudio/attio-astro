---
import LegalLayout from "../../components/LegalLayout.astro";
import legal from "../../data/legal.json";

// Cookie Policy, copy fetched live from https://attio.com/legal/cookies
// on 2026-11-16 (HTTP 200). Data lives in src/data/legal.json.
const entry = (legal as any[]).find((entry) => entry.slug === "cookies");
if (!entry) throw new Error("Missing legal data for cookies");
---

<LegalLayout entry={entry} />
