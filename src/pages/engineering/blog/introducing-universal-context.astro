---
import EngineeringPost from "../../../components/EngineeringPost.astro";
import data from "../../../data/engineering.json";

// Introducing Universal Context, copy fetched live from https://attio.com/engineering/blog/introducing-universal-context
// on 2026-11-16 (HTTP 200). Data lives in src/data/engineering.json.
const post = data.posts.find((entry) => entry.slug === "introducing-universal-context");
if (!post) throw new Error("Missing engineering post data for introducing-universal-context");
---

<EngineeringPost post={post} />
