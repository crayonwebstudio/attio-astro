---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Image support in notes, copy fetched live from https://attio.com/changelog/2024/image-support-in-notes
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2024/image-support-in-notes");
if (!entry) throw new Error("Missing changelog data for /changelog/2024/image-support-in-notes");
---

<ChangelogEntry entry={entry} />
