---
import LegalLayout from "../../components/LegalLayout.astro";
import legal from "../../data/legal.json";

// Demo Gift Program Policy, copy fetched live from https://attio.com/legal/demo-gift-program
// on 2026-11-16 (HTTP 200). Data lives in src/data/legal.json.
const entry = (legal as any[]).find((entry) => entry.slug === "demo-gift-program");
if (!entry) throw new Error("Missing legal data for demo-gift-program");
---

<LegalLayout entry={entry} />
