---
import EngineeringPost from "../../../components/EngineeringPost.astro";
import data from "../../../data/engineering.json";

// A new type of user requires a new type of architecture, copy fetched live from https://attio.com/engineering/blog/A-new-type-of-user-requires-a-new-type-of-architecture
// on 2026-11-16 (HTTP 200). Data lives in src/data/engineering.json.
const post = data.posts.find((entry) => entry.slug === "A-new-type-of-user-requires-a-new-type-of-architecture");
if (!post) throw new Error("Missing engineering post data for A-new-type-of-user-requires-a-new-type-of-architecture");
---

<EngineeringPost post={post} />
