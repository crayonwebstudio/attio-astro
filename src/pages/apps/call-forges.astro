---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for CallForges, copy fetched live from https://attio.com/apps/call-forges
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "call-forges");
if (!app) throw new Error("Missing app detail: call-forges");
---

<AppDetail app={app} />
