---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Central AI, copy fetched live from https://attio.com/apps/central-ai
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "central-ai");
if (!app) throw new Error("Missing app detail: central-ai");
---

<AppDetail app={app} />
