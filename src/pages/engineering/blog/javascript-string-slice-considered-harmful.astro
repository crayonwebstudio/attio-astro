---
import EngineeringPost from "../../../components/EngineeringPost.astro";
import data from "../../../data/engineering.json";

// JavaScript string slice() considered harmful, copy fetched live from https://attio.com/engineering/blog/javascript-string-slice-considered-harmful
// on 2026-11-16 (HTTP 200). Data lives in src/data/engineering.json.
const post = data.posts.find((entry) => entry.slug === "javascript-string-slice-considered-harmful");
if (!post) throw new Error("Missing engineering post data for javascript-string-slice-considered-harmful");
---

<EngineeringPost post={post} />
