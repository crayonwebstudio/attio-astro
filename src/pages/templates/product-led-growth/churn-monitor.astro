---
import WorkflowTemplate from "../../../components/WorkflowTemplate.astro";
import templates from "../../../data/templates.json";

// Churn monitor, copy fetched live from https://attio.com/templates/product-led-growth/churn-monitor
// on 2026-11-17 (HTTP 200). Data lives in src/data/templates.json.
const entry = (templates as any[]).find((entry) => entry.path === "/templates/product-led-growth/churn-monitor");
if (!entry) throw new Error("Missing template data for /templates/product-led-growth/churn-monitor");
---

<WorkflowTemplate entry={entry} />
