---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Workflows: orchestrate revenue agents, on every account, copy fetched live from https://attio.com/blog/orchestrate-revenue-agents
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "orchestrate-revenue-agents");
if (!post) throw new Error("Missing post data for orchestrate-revenue-agents");
---

<BlogPost post={post} />
