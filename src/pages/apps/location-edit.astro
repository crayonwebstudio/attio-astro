---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Better Location Attribute, copy fetched live from https://attio.com/apps/location-edit
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "location-edit");
if (!app) throw new Error("Missing app detail: location-edit");
---

<AppDetail app={app} />
