---
import HelpCategory from "../../../components/HelpCategory.astro";
import help from "../../../data/help.json";

// Tools and extensions, copy fetched live from https://attio.com/help/reference/tools-and-extensions
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/tools-and-extensions");
if (!entry) throw new Error("Missing help data for reference/tools-and-extensions");
---

<HelpCategory entry={entry} />
