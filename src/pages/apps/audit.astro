---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Audit, copy fetched live from https://attio.com/apps/audit
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "audit");
if (!app) throw new Error("Missing app detail: audit");
---

<AppDetail app={app} />
