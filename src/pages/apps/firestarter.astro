---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Firestarter, copy fetched live from https://attio.com/apps/firestarter
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "firestarter");
if (!app) throw new Error("Missing app detail: firestarter");
---

<AppDetail app={app} />
