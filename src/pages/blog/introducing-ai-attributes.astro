---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Introducing AI Attributes, copy fetched live from https://attio.com/blog/introducing-ai-attributes
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "introducing-ai-attributes");
if (!post) throw new Error("Missing post data for introducing-ai-attributes");
---

<BlogPost post={post} />
