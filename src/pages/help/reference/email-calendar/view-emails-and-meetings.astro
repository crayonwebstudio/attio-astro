---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// View emails and meetings, copy fetched live from https://attio.com/help/reference/email-calendar/view-emails-and-meetings
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/email-calendar/view-emails-and-meetings");
if (!entry) throw new Error("Missing help data for reference/email-calendar/view-emails-and-meetings");
---

<HelpArticle entry={entry} />
