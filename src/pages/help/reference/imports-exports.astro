---
import HelpCategory from "../../../components/HelpCategory.astro";
import help from "../../../data/help.json";

// Imports & exports, copy fetched live from https://attio.com/help/reference/imports-exports
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/imports-exports");
if (!entry) throw new Error("Missing help data for reference/imports-exports");
---

<HelpCategory entry={entry} />
