---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Mobile activity feed, copy fetched live from https://attio.com/changelog/2026/mobile-activity-feed
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2026/mobile-activity-feed");
if (!entry) throw new Error("Missing changelog data for /changelog/2026/mobile-activity-feed");
---

<ChangelogEntry entry={entry} />
