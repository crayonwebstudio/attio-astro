---
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy fetched live from https://attio.com/help on 2026-11-16 (HTTP 200, 510KB).
// Product visuals are rebuilt as HTML/CSS mocks, no Attio images are hotlinked or copied.
// The live page has NO standard FinalCta ("Agentic revenue runs on Attio."
// appears 0 times in the live HTML), so this page hides the shared FinalCta and
// renders no closing CTA section, as on live. The live page has no <input> element:
// search is a "Search help…" button with a Cmd+K hint that opens a search palette
// (live i18n: ariaLabel "Search Help Center", placeholder "Search help…",
// no results "No content matching"), rebuilt here as a client-side overlay that
// filters the help destinations on this page. Popular searches are buttons that
// open the palette with that query. The sidebar (Academy courses + Reference
// categories) is hidden below the lg breakpoint on live, rendered the same here.
// Article links on this page: 28 distinct /help hrefs in the live HTML, 21 in the
// sidebar nav (Academy group + 5 courses, Reference group + 14 categories), 6 in
// the main content (2 cards, 3 Attio 101 articles, 1 see-all link). Help article
// pages are not built yet, so these links 404 until then.
const academyCourses = [
  { slug: "introduction", title: "Introductions" },
  { slug: "workflows-course", title: "Workflows" },
  { slug: "sequences", title: "Sequences" },
  { slug: "reports-course", title: "Reports" },
  { slug: "attio-for-product-led-growth", title: "Attio for product-led growth" },
];

const referenceCategories = [
  { slug: "attio-101", title: "Attio 101" },
  { slug: "attio-ai", title: "Attio AI" },
  { slug: "managing-your-data", title: "Managing your data" },
  { slug: "email-calendar", title: "Email & calendar" },
  { slug: "imports-exports", title: "Imports & exports" },
  { slug: "productivity-collaborating", title: "Productivity & collaborating" },
  { slug: "automations", title: "Automations" },
  { slug: "apps", title: "Apps" },
  { slug: "tools-and-extensions", title: "Tools and extensions" },
  { slug: "account-settings", title: "Account settings" },
  { slug: "workspace-settings-billing", title: "Workspace settings & billing" },
  { slug: "how-to-guides", title: "How-to guides" },
  { slug: "industry-guides", title: "Industry guides" },
  { slug: "support", title: "Support" },
];

const cards = [
  {
    href: "/help/academy",
    title: "Academy",
    copy: "Courses to get started with Attio",
  },
  {
    href: "/help/reference",
    title: "Reference",
    copy: "Essential Attio features explained",
  },
  {
    href: "https://docs.attio.com/",
    title: "Developers",
    copy: "Technical guides to our API, SDK, and MCP",
  },
];

const attio101 = [
  {
    n: "1",
    href: "/help/reference/attio-101/introduction",
    title: "Introduction",
    copy: "Begin your journey with Attio.",
  },
  {
    n: "2",
    href: "/help/reference/attio-101/introduction-to-navigating-attio",
    title: "Introduction to navigating Attio",
    copy: "Get to know your way around Attio.",
  },
  {
    n: "3",
    href: "/help/reference/attio-101/syncing-people-and-companies",
    title: "Introduction to email sync",
    copy: "Sync emails and calendar events in minutes.",
  },
];

const popularSearches = ["importing", "billing", "integrations"];

// Search index for the palette: every help destination on this page.
const searchIndex = [
  ...academyCourses.map((c) => ({
    title: c.title,
    href: `/help/academy/${c.slug}`,
    group: "Academy",
  })),
  ...referenceCategories.map((c) => ({
    title: c.title,
    href: `/help/reference/${c.slug}`,
    group: "Reference",
  })),
  ...attio101.map((a) => ({
    title: a.title,
    href: a.href,
    group: "Attio 101",
  })),
];
---

<BaseLayout
  title="How can we help? | Attio Help Center"
  description="Get answers to common questions on all things Attio"
  hideFinalCta
>
  <div class="mx-auto grid max-w-[1200px] lg:grid-cols-[260px_1fr]">
    <!-- Sidebar nav, hidden below lg on live -->
    <nav
      class="hidden border-r border-paper-500 py-10 pr-6 lg:block"
      aria-label="Help Center Contents"
    >
      <button
        type="button"
        data-open-search
        class="flex w-full items-center justify-between rounded-xl border border-paper-500 bg-white px-4 py-2.5 text-sm font-medium text-ink-700 transition-colors hover:border-ink-800"
      >
        <span>Search...</span>
        <kbd class="rounded-md border border-paper-500 bg-paper-200 px-1.5 py-0.5 text-xs font-semibold text-ink-600">
          ⌘K
        </kbd>
      </button>

      <p class="mt-8 text-sm font-semibold">
        <a href="/help/academy" class="hover:underline">Academy</a>
      </p>
      <ul class="mt-3 space-y-1">
        {academyCourses.map((course) => (
          <li>
            <a
              href={`/help/academy/${course.slug}`}
              class="block rounded-lg px-3 py-2 text-sm text-ink-600 transition-colors hover:bg-paper-200 hover:text-ink-100"
            >
              {course.title}
            </a>
          </li>
        ))}
      </ul>

      <p class="mt-8 text-sm font-semibold">
        <a href="/help/reference" class="hover:underline">Reference</a>
      </p>
      <ul class="mt-3 space-y-1">
        {referenceCategories.map((category) => (
          <li>
            <a
              href={`/help/reference/${category.slug}`}
              class="block rounded-lg px-3 py-2 text-sm text-ink-600 transition-colors hover:bg-paper-200 hover:text-ink-100"
            >
              {category.title}
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <!-- Main column -->
    <div class="px-4 pb-24 sm:px-6 lg:pl-10">
      <!-- Workshop banner -->
      <div class="pt-8">
        <a
          href="https://www.attio.community/c/workshops/getting-started-attio-101-uk-europe-32317c"
          class="inline-flex items-center gap-2 rounded-full border border-paper-500 bg-white px-4 py-2 text-sm font-medium text-ink-100 transition-colors hover:border-ink-800"
        >
          Join the next Attio workshop on November 17
          <span aria-hidden="true">→</span>
        </a>
      </div>

      <!-- Hero -->
      <section class="pt-12 sm:pt-16">
        <h1 class="font-display text-[44px] font-semibold leading-[1.05] tracking-tight sm:text-[72px]">
          How can we help?
        </h1>
        <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 sm:text-xl">
          Get answers to common questions on all things Attio
        </p>

        <button
          type="button"
          data-open-search
          class="mt-8 flex w-full max-w-xl items-center justify-between rounded-xl border border-paper-500 bg-white px-4 py-3 text-left text-base text-ink-700 shadow-sm transition-colors hover:border-ink-800"
        >
          <span>Search help…</span>
          <kbd class="rounded-md border border-paper-500 bg-paper-200 px-1.5 py-0.5 text-xs font-semibold text-ink-600">
            ⌘K
          </kbd>
        </button>

        <p class="mt-6 flex flex-wrap items-center gap-2 text-sm text-ink-600">
          <span>Popular searches:</span>
          {popularSearches.map((term) => (
            <button
              type="button"
              data-popular-search={term}
              class="rounded-lg border border-paper-500 bg-white px-2.5 py-1 text-sm font-medium text-ink-100 transition-colors hover:border-ink-800"
            >
              {term}
            </button>
          ))}
        </p>
      </section>

      <!-- Academy / Reference / Developers cards -->
      <section class="mt-14" aria-label="Help sections">
        <div class="grid gap-6 md:grid-cols-3">
          {cards.map((card) => (
            <a
              href={card.href}
              class="group flex flex-col gap-4 overflow-hidden rounded-2xl border border-paper-500 bg-white p-6 transition-shadow hover:shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)]"
            >
              <h3 class="font-display text-2xl font-semibold tracking-tight">{card.title}</h3>
              <p class="text-sm leading-relaxed text-ink-600">{card.copy}</p>
            </a>
          ))}
        </div>
      </section>

      <!-- Get started with Attio 101 -->
      <section class="mt-20" aria-label="Get started with Attio 101">
        <h2 class="font-display text-heading-md font-semibold tracking-tight">
          Get started with Attio 101.
        </h2>
        <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
          Everything you need to master the basics of Attio.
        </p>

        <ol class="mt-10 space-y-4">
          {attio101.map((article) => (
            <li>
              <a
                href={article.href}
                class="group flex items-start gap-5 rounded-2xl border border-paper-500 bg-white p-6 transition-shadow hover:shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)]"
              >
                <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-100 text-sm font-semibold text-blue-600">
                  {article.n}
                </span>
                <span>
                  <span class="block font-display text-xl font-semibold tracking-tight">
                    {article.title}
                  </span>
                  <span class="mt-1 block text-sm leading-relaxed text-ink-600">
                    {article.copy}
                  </span>
                </span>
              </a>
            </li>
          ))}
        </ol>

        <p class="mt-8">
          <a
            href="/help/reference/attio-101/"
            class="text-sm font-semibold text-ink-100 underline underline-offset-4"
          >
            See all articles...
          </a>
        </p>
      </section>
    </div>
  </div>

  <!-- Search palette -->
  <div
    id="help-search-overlay"
    class="fixed inset-0 z-[100] hidden items-start justify-center bg-ink-50/60 px-4 pt-24"
    role="dialog"
    aria-modal="true"
    aria-label="Search Help Center"
  >
    <div class="w-full max-w-xl overflow-hidden rounded-2xl border border-paper-500 bg-white shadow-[0_24px_64px_-24px_rgba(16,16,16,0.35)]">
      <div class="flex items-center gap-3 border-b border-paper-400 px-4 py-3">
        <span aria-hidden="true" class="text-ink-700">⌕</span>
        <input
          id="help-search-input"
          type="text"
          placeholder="Search help…"
          autocomplete="off"
          class="w-full bg-transparent text-base text-ink-100 outline-none placeholder:text-ink-700"
        />
        <kbd class="shrink-0 rounded-md border border-paper-500 bg-paper-200 px-1.5 py-0.5 text-xs font-semibold text-ink-600">
          Esc
        </kbd>
      </div>
      <ul id="help-search-results" class="max-h-[320px] overflow-y-auto py-2">
        {searchIndex.map((item) => (
          <li>
            <a
              href={item.href}
              data-search-item
              data-title={item.title.toLowerCase()}
              class="flex items-center justify-between gap-4 px-4 py-2.5 text-sm transition-colors hover:bg-paper-200"
            >
              <span class="font-medium text-ink-100">{item.title}</span>
              <span class="shrink-0 text-xs text-ink-700">{item.group}</span>
            </a>
          </li>
        ))}
      </ul>
      <p id="help-search-empty" class="hidden px-4 py-6 text-sm text-ink-600">
        No content matching
      </p>
    </div>
  </div>
</BaseLayout>

<script>
  // Search palette, as on live: opened by the search buttons, Cmd+K, or a popular
  // search term. Filters the help destinations listed on this page.
  const overlay = document.getElementById("help-search-overlay");
  const input = document.getElementById("help-search-input");
  const results = document.getElementById("help-search-results");
  const empty = document.getElementById("help-search-empty");
  const items = Array.from(document.querySelectorAll("[data-search-item]"));

  function openSearch(query) {
    if (!overlay || !input) return;
    overlay.classList.remove("hidden");
    overlay.classList.add("flex");
    if (typeof query === "string") input.value = query;
    filterResults();
    input.focus();
  }

  function closeSearch() {
    if (!overlay || !input) return;
    overlay.classList.add("hidden");
    overlay.classList.remove("flex");
    input.value = "";
    filterResults();
  }

  function filterResults() {
    if (!input || !results || !empty) return;
    const q = input.value.trim().toLowerCase();
    let visible = 0;
    items.forEach((item) => {
      const show = !q || item.getAttribute("data-title").includes(q);
      item.closest("li").classList.toggle("hidden", !show);
      if (show) visible += 1;
    });
    empty.classList.toggle("hidden", visible > 0);
  }

  document.querySelectorAll("[data-open-search]").forEach((button) => {
    button.addEventListener("click", () => openSearch(""));
  });
  document.querySelectorAll("[data-popular-search]").forEach((button) => {
    button.addEventListener("click", () => openSearch(button.getAttribute("data-popular-search")));
  });
  if (input) input.addEventListener("input", filterResults);
  if (overlay) {
    overlay.addEventListener("click", (event) => {
      if (event.target === overlay) closeSearch();
    });
  }
  document.addEventListener("keydown", (event) => {
    if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
      event.preventDefault();
      if (overlay && overlay.classList.contains("hidden")) openSearch("");
    } else if (event.key === "Escape") {
      closeSearch();
    }
  });
</script>
