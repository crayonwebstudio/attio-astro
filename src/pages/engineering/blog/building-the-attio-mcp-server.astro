---
import EngineeringPost from "../../../components/EngineeringPost.astro";
import data from "../../../data/engineering.json";

// Building the Attio MCP server, copy fetched live from https://attio.com/engineering/blog/building-the-attio-mcp-server
// on 2026-11-16 (HTTP 200). Data lives in src/data/engineering.json.
const post = data.posts.find((entry) => entry.slug === "building-the-attio-mcp-server");
if (!post) throw new Error("Missing engineering post data for building-the-attio-mcp-server");
---

<EngineeringPost post={post} />
