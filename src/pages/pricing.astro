---
import BaseLayout from "../layouts/BaseLayout.astro";

const plans = [
  {
    name: "Free",
    blurb: "For individuals to get started with Attio.",
    monthly: 0,
    annual: 0,
    priceNote: "Free forever, up to 3 users.",
    addUserMonthly: null,
    addUserAnnual: null,
    cta: "Start for free",
    ctaHref: "/go/welcome/sign-in",
    featured: false,
    badge: null,
    features: [
      "Ask Attio, your personal agent",
      "Self-builds from email and calendar",
      "Automatic enrichment",
      "Agents and workflows",
      "50,000 records and 3 objects",
    ],
  },
  {
    name: "Plus",
    blurb: "For small teams building their first sales process.",
    monthly: 50,
    annual: 40,
    priceNote: "Per workspace, includes 1 user.",
    addUserMonthly: 44,
    addUserAnnual: 35,
    cta: "Start for free",
    ctaHref: "/go/welcome/sign-in",
    featured: false,
    badge: null,
    features: [
      "Everything in Free, and:",
      "Email sharing and AI summaries",
      "Send 1,000 emails/mo",
      "Private lists",
      "Basic permissions",
      "250,000 records and 5 objects",
    ],
  },
  {
    name: "Pro",
    blurb: "For growing teams turning sales into a repeatable engine.",
    monthly: 125,
    annual: 100,
    priceNote: "Per workspace, includes 1 user.",
    addUserMonthly: 99,
    addUserAnnual: 79,
    cta: "Start 14-day free trial",
    ctaHref: "/go/welcome/sign-in",
    featured: true,
    badge: "Most popular",
    features: [
      "Everything in Plus, and:",
      "Custom objects",
      "Call intelligence",
      "Sequences",
      "Team and user permissions",
      "Advanced reporting",
      "Track product usage and events",
      "Data rules for reps and agents",
      "1M records and 12 objects",
    ],
  },
  {
    name: "Ultra",
    blurb: "For teams and orgs running multiple GTM motions at scale.",
    monthly: 1000,
    annual: 1000,
    priceNote: "Per workspace, includes 5 users, annual billing only.",
    addUserMonthly: 189,
    addUserAnnual: 189,
    cta: "Talk to sales",
    ctaHref: "/contact/sales",
    featured: false,
    badge: null,
    features: [
      "Everything in Pro, and:",
      "Unlimited objects",
      "Query in SQL with API or MCP",
      "Data connector",
      "Unlimited data rules by team",
      "Single sign-on (SSO)",
      "User provisioning (SCIM)",
      "Audit logs",
      "Advanced controls",
      "Forward-deployed onboarding",
    ],
  },
];

const check = "✓";
const cross = "✕";

const compareGroups = [
  {
    group: "Platform features",
    rows: [
      { label: "Ask Attio credits", free: "100", plus: "500", pro: "1,000", ultra: "2,500" },
      { label: "Workspace credits", free: "250", plus: "1,500", pro: "10,000", ultra: "20,000" },
      { label: "Records", free: "50,000", plus: "250,000", pro: "1,000,000", ultra: "3,000,000" },
      { label: "Objects", free: "3", plus: "5", pro: "12", ultra: "Unlimited" },
      { label: "File storage", free: "50 GB", plus: "50 GB", pro: "Unlimited", ultra: "Unlimited" },
      { label: "Company enrichment", free: "Core profile", plus: "+ Headcount and ARR", pro: "+ Funding", ultra: "+ Funding" },
      { label: "Reports", free: cross, plus: "15", pro: "100", ultra: "Unlimited" },
      { label: "Report types", free: "Insights", plus: "+ Funnels and segments", pro: "+ Targets and trends", ultra: "+ Targets and trends" },
      { label: "Rules", free: cross, plus: cross, pro: "8 per object", ultra: "Unlimited" },
      { label: "Emails sent per user", free: "200/mo", plus: "1,000/mo", pro: "Unlimited", ultra: "Unlimited" },
      { label: "Bulk email", free: "10 at once", plus: "50 at once", pro: "50 at once", ultra: "50 at once" },
      { label: "Users", free: "Up to 3", plus: "Up to 10", pro: "No limit", ultra: "No limit" },
      { label: "Teams", free: cross, plus: cross, pro: "Up to 10", ultra: "Unlimited" },
    ],
  },
  {
    group: "Agents and AI",
    rows: [
      { label: "Ask Attio", free: check, plus: check, pro: check, ultra: check },
      { label: "Agents and workflows", free: check, plus: check, pro: check, ultra: check },
      { label: "Custom agents", free: cross, plus: cross, pro: check, ultra: check },
      { label: "Call intelligence", free: cross, plus: cross, pro: check, ultra: check },
      { label: "Sequences", free: cross, plus: cross, pro: check, ultra: check },
    ],
  },
  {
    group: "Security and admin",
    rows: [
      { label: "Single sign-on (SSO)", free: cross, plus: cross, pro: "Governance add-on", ultra: check },
      { label: "User provisioning (SCIM)", free: cross, plus: cross, pro: "Governance add-on", ultra: check },
      { label: "Audit logs", free: cross, plus: cross, pro: "Governance add-on", ultra: check },
      { label: "Admin-only exports", free: cross, plus: cross, pro: "Governance add-on", ultra: check },
      { label: "Advanced controls", free: cross, plus: cross, pro: cross, ultra: check },
    ],
  },
  {
    group: "Support and services",
    rows: [
      { label: "Data connectors", free: cross, plus: cross, pro: cross, ultra: "1 included" },
      { label: "Migration help", free: cross, plus: check, pro: check, ultra: check },
      { label: "Forward-deployed onboarding", free: cross, plus: cross, pro: cross, ultra: check },
      { label: "14-day free trial of Pro", free: check, plus: check, pro: check, ultra: check },
    ],
  },
];

const creditPacks = [
  { credits: "5,000", annual: 70, monthly: 85 },
  { credits: "10,000", annual: 120, monthly: 150 },
  { credits: "25,000", annual: 260, monthly: 330 },
  { credits: "50,000", annual: 475, monthly: 595 },
];

const faqs = [
  {
    q: "Does Attio have a free plan?",
    a: "Yes. The Free plan costs nothing for up to three users, and includes Ask Attio, self-builds from email and calendar, automatic enrichment, agents and workflows, 50,000 records and 3 objects.",
  },
  {
    q: "Can I try Attio before I pay?",
    a: "Yes. Every new workspace gets a 14-day free trial of Pro, with no card required to start.",
  },
  {
    q: "Is there a discount for paying annually?",
    a: "Yes. Annual billing saves 20% on Plus and Pro compared with monthly billing. Ultra is billed annually only.",
  },
  {
    q: "Which Attio plan is right for my team?",
    a: "Free fits individuals getting started. Plus fits small teams building their first sales process. Pro fits growing teams turning sales into a repeatable engine. Ultra fits teams and orgs running multiple GTM motions at scale.",
  },
  {
    q: "Can I get SSO on the Pro plan?",
    a: "Yes, with the Governance add-on at $30 per user per month, billed annually. It adds SSO, SCIM, audit logs and advanced data controls on Pro. SSO is included with Ultra.",
  },
  {
    q: "Do I need to talk to sales to buy Ultra?",
    a: "Yes. Ultra is an annual plan with forward-deployed onboarding, so talk to sales to get started.",
  },
  {
    q: "Can I change or cancel my plan at any time?",
    a: "Yes. You can change plans in your workspace settings. Upgrades are prorated, and downgrades apply at your next renewal.",
  },
  {
    q: "How do credits work in Attio?",
    a: "Ask Attio credits and workspace credits are included with each plan. Free includes 100 Ask Attio credits and 250 workspace credits, Plus includes 500 and 1,500, Pro includes 1,000 and 10,000, and Ultra includes 2,500 and 20,000.",
  },
  {
    q: "How much do additional credits cost?",
    a: "Additional credits are sold in packs. A 5,000 credit pack is $70 per month on annual billing or $85 on monthly billing, 10,000 is $120 or $150, 25,000 is $260 or $330, and 50,000 is $475 or $595.",
  },
  {
    q: "What are my payment options?",
    a: "You can pay by card on every plan. Pro and Ultra also support invoice, purchase order, ACH, check and wire.",
  },
  {
    q: "Does Attio offer discounts for startups?",
    a: "Yes. Venture-backed startups with up to 10 users get 80% off annual Pro plus credits for year 1, and 30% off for year 2. Apply within 90 days of workspace creation.",
  },
  {
    q: "Can I use Attio with Claude, ChatGPT, or other AI tools?",
    a: "Yes. Attio has an MCP server on every plan, and Ultra adds SQL querying through the API and MCP, so your AI tools can work with your CRM data.",
  },
  {
    q: "Can Attio help me migrate from another CRM?",
    a: "Yes. Migration help is included on paid plans, and Ultra includes forward-deployed engineer onboarding.",
  },
];
---

<BaseLayout
  title="Plans & Pricing | Attio"
  description="Start for free. Whether you're a startup or enterprise, Attio is the CRM for agentic revenue at every stage of growth."
>
  <!-- Hero -->
  <section class="mx-auto max-w-[1200px] px-4 pb-12 pt-16 text-center sm:px-6 sm:pt-24">
    <h1 class="mx-auto max-w-4xl font-display text-[56px] font-semibold leading-[1.05] tracking-tight sm:text-[72px]">
      Revenue around the clock.
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 sm:text-xl">
      Start for free with plans for every stage of growth, whether startup or enterprise.
    </p>

    <!-- Billing toggle -->
    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <div
        class="inline-flex rounded-full bg-paper-300 p-1"
        role="group"
        aria-label="Billing period"
      >
        <button
          type="button"
          data-billing-toggle="monthly"
          class="rounded-full px-5 py-2 text-sm font-semibold text-ink-100"
          aria-pressed="false"
        >
          Monthly
        </button>
        <button
          type="button"
          data-billing-toggle="annual"
          class="rounded-full bg-ink-100 px-5 py-2 text-sm font-semibold text-white"
          aria-pressed="true"
        >
          Annual
        </button>
      </div>
      <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-600">
        Save 20% with annual billing
      </span>
    </div>
  </section>

  <!-- Plan cards -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Plans">
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
      {
        plans.map((plan) => (
          <article
            class={
              "flex flex-col rounded-2xl border p-6 " +
              (plan.featured
                ? "border-ink-100 bg-ink-100 text-white shadow-xl"
                : "border-paper-500 bg-white")
            }
          >
            {plan.badge && (
              <span class="mb-3 inline-flex w-fit rounded-full bg-blue-500 px-3 py-1 text-xs font-semibold text-white">
                {plan.badge}
              </span>
            )}
            <h2 class="font-display text-xl font-semibold">{plan.name}</h2>
            <p class={"mt-2 text-sm leading-relaxed " + (plan.featured ? "text-white/70" : "text-ink-600")}>
              {plan.blurb}
            </p>
            <p class="mt-6 flex items-baseline gap-1">
              <span class="font-display text-5xl font-semibold">
                $
                <span
                  data-price-monthly={plan.monthly}
                  data-price-annual={plan.annual}
                >
                  {plan.annual}
                </span>
              </span>
              <span class={"text-sm " + (plan.featured ? "text-white/70" : "text-ink-600")}>/mo</span>
            </p>
            <p class={"mt-2 text-xs leading-relaxed " + (plan.featured ? "text-white/70" : "text-ink-600")}>
              {plan.priceNote}
            </p>
            {plan.addUserMonthly !== null && (
              <p class={"mt-1 text-xs " + (plan.featured ? "text-white/70" : "text-ink-600")}>
                Add users{" "}
                <span
                  data-adduser-monthly={plan.addUserMonthly}
                  data-adduser-annual={plan.addUserAnnual}
                >
                  ${plan.addUserAnnual}
                </span>
                /mo each
              </p>
            )}
            <a
              href={plan.ctaHref}
              class={
                "mt-6 rounded-full px-5 py-3 text-center text-sm font-semibold " +
                (plan.featured
                  ? "bg-white text-ink-100 hover:bg-paper-200"
                  : "bg-ink-100 text-white hover:bg-ink-300")
              }
            >
              {plan.cta}
            </a>
            <ul class="mt-6 space-y-2.5 text-sm">
              {plan.features.map((feature) => (
                <li class="flex gap-2">
                  <span aria-hidden="true" class={plan.featured ? "text-blue-300" : "text-blue-500"}>
                    ✓
                  </span>
                  <span class={plan.featured ? "text-white/90" : "text-ink-600"}>{feature}</span>
                </li>
              ))}
            </ul>
          </article>
        ))
      }
    </div>
    <p class="mt-6 text-center text-sm text-ink-600">
      All plans include the Attio MCP server. Ultra is billed annually only.
    </p>
  </section>

  <!-- Compare plans -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Compare plans">
    <h2 class="text-center font-display text-heading-sm font-semibold tracking-tight sm:text-heading-md">
      Compare plans
    </h2>
    <p class="mx-auto mt-3 max-w-2xl text-center text-base leading-relaxed text-ink-600">
      Every plan starts free. Pick the one that fits where your team is going next.
    </p>
    <div class="mt-10 overflow-x-auto rounded-2xl border border-paper-500">
      <table class="w-full min-w-[720px] border-collapse text-sm">
        <thead>
          <tr class="border-b border-paper-500 bg-paper-200 text-left">
            <th scope="col" class="px-4 py-4 font-semibold">Feature</th>
            <th scope="col" class="px-4 py-4 font-semibold">Free</th>
            <th scope="col" class="px-4 py-4 font-semibold">Plus</th>
            <th scope="col" class="px-4 py-4 font-semibold">Pro</th>
            <th scope="col" class="px-4 py-4 font-semibold">Ultra</th>
          </tr>
        </thead>
        <tbody>
          {
            compareGroups.map((group) => (
              <>
                <tr class="bg-paper-300">
                  <th scope="row" colspan="5" class="px-4 py-3 text-left font-semibold">
                    {group.group}
                  </th>
                </tr>
                {group.rows.map((row) => (
                  <tr class="border-b border-paper-400 last:border-b-0">
                    <th scope="row" class="px-4 py-3 text-left font-medium text-ink-600">
                      {row.label}
                    </th>
                    <td class="px-4 py-3">{row.free}</td>
                    <td class="px-4 py-3">{row.plus}</td>
                    <td class="px-4 py-3">{row.pro}</td>
                    <td class="px-4 py-3">{row.ultra}</td>
                  </tr>
                ))}
              </>
            ))
          }
        </tbody>
      </table>
    </div>
    <p class="mt-4 text-center text-sm text-ink-600">
      Additional records on Pro and Ultra are $300/mo monthly or $240/mo annual per 1M records. Additional objects on Pro are $500/mo monthly or $400/mo annual each.
    </p>
  </section>

  <!-- Credits -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Credits">
    <div class="grid gap-4 lg:grid-cols-2">
      <div class="rounded-2xl border border-paper-500 p-6 sm:p-8">
        <h2 class="font-display text-heading-xs font-semibold tracking-tight">Additional credits</h2>
        <p class="mt-2 text-sm leading-relaxed text-ink-600">
          Need more than your plan includes? Buy credit packs. Additional workspace credits start from $85/mo on monthly billing or $70/mo on annual billing.
        </p>
        <table class="mt-6 w-full border-collapse text-sm">
          <thead>
            <tr class="border-b border-paper-500 text-left text-ink-600">
              <th scope="col" class="py-2 pr-2 font-semibold">Credits</th>
              <th scope="col" class="py-2 pr-2 font-semibold">Annual</th>
              <th scope="col" class="py-2 font-semibold">Monthly</th>
            </tr>
          </thead>
          <tbody>
            {
              creditPacks.map((pack) => (
                <tr class="border-b border-paper-400 last:border-b-0">
                  <td class="py-3 pr-2 font-medium">{pack.credits} credits</td>
                  <td class="py-3 pr-2">${pack.annual}/mo</td>
                  <td class="py-3">${pack.monthly}/mo</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
      <div class="rounded-2xl border border-paper-500 bg-ink-100 p-6 text-white sm:p-8">
        <h2 class="font-display text-heading-xs font-semibold tracking-tight">Governance add-on</h2>
        <p class="mt-2 text-sm leading-relaxed text-white/70">
          $30 per user per month, billed annually, on Pro. Included with Ultra.
        </p>
        <ul class="mt-6 space-y-2.5 text-sm">
          <li class="flex gap-2"><span aria-hidden="true" class="text-blue-300">✓</span><span>Single sign-on (SSO)</span></li>
          <li class="flex gap-2"><span aria-hidden="true" class="text-blue-300">✓</span><span>User provisioning (SCIM)</span></li>
          <li class="flex gap-2"><span aria-hidden="true" class="text-blue-300">✓</span><span>Audit logs</span></li>
          <li class="flex gap-2"><span aria-hidden="true" class="text-blue-300">✓</span><span>Advanced data controls</span></li>
        </ul>
        <a
          href="/contact/sales"
          class="mt-8 inline-flex rounded-full bg-white px-5 py-3 text-sm font-semibold text-ink-100 hover:bg-paper-200"
        >
          Talk to sales &rarr;
        </a>
      </div>
    </div>
  </section>

  <!-- Startup discount -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Startup discount">
    <div class="rounded-2xl border border-paper-500 bg-paper-200 p-6 text-center sm:p-10">
      <h2 class="font-display text-heading-xs font-semibold tracking-tight sm:text-heading-sm">
        Building a startup? Get 80% off Pro for year 1.
      </h2>
      <p class="mx-auto mt-3 max-w-2xl text-base leading-relaxed text-ink-600">
        Venture-backed startups with up to 10 users get 80% off annual Pro plus credits for year 1, and 30% off for year 2. Apply within 90 days of workspace creation.
      </p>
      <a
        href="/startups"
        class="mt-6 inline-flex rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Explore the startup program &rarr;
      </a>
    </div>
  </section>

  <!-- Testimonial -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 text-center sm:px-6">
    <blockquote class="mx-auto max-w-3xl font-serif text-2xl leading-snug text-ink-100 sm:text-3xl">
      "When I first opened Attio, I instantly got the feeling this was the next generation of CRM."
    </blockquote>
    <p class="mt-6 text-sm font-semibold">Margaret Shen</p>
    <p class="text-sm text-ink-700">Head of Business Operations, Modal</p>
  </section>

  <!-- FAQ -->
  <section class="mx-auto max-w-[800px] px-4 pb-24 sm:px-6" aria-label="Frequently asked questions">
    <h2 class="text-center font-display text-heading-sm font-semibold tracking-tight sm:text-heading-md">
      Frequently asked questions
    </h2>
    <div class="mt-10 space-y-3">
      {
        faqs.map((faq) => (
          <div class="rounded-xl border border-paper-500">
            <button
              type="button"
              data-faq-button
              aria-expanded="false"
              class="flex w-full items-center justify-between gap-4 px-5 py-4 text-left text-base font-semibold"
            >
              <span>{faq.q}</span>
              <span aria-hidden="true" class="shrink-0 text-ink-600" data-faq-icon>+</span>
            </button>
            <div data-faq-panel hidden class="px-5 pb-5 text-sm leading-relaxed text-ink-600">
              {faq.a}
            </div>
          </div>
        ))
      }
    </div>
  </section>

  <script>
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;

    // Billing toggle: switch displayed plan and add-user prices.
    const toggleButtons = Array.from(document.querySelectorAll("[data-billing-toggle]"));
    const setBilling = (period) => {
      toggleButtons.forEach((button) => {
        const active = button.getAttribute("data-billing-toggle") === period;
        button.setAttribute("aria-pressed", String(active));
        button.classList.toggle("bg-ink-100", active);
        button.classList.toggle("text-white", active);
        button.classList.toggle("text-ink-100", !active);
      });
      document.querySelectorAll("[data-price-monthly]").forEach((el) => {
        const value = el.getAttribute(period === "annual" ? "data-price-annual" : "data-price-monthly");
        if (value !== null) el.textContent = value;
      });
      document.querySelectorAll("[data-adduser-monthly]").forEach((el) => {
        const value = el.getAttribute(period === "annual" ? "data-adduser-annual" : "data-adduser-monthly");
        if (value !== null) el.textContent = "$" + value;
      });
    };
    toggleButtons.forEach((button) => {
      button.addEventListener("click", () => {
        setBilling(button.getAttribute("data-billing-toggle") || "annual");
      });
    });

    // FAQ accordion: one open at a time.
    const faqButtons = Array.from(document.querySelectorAll("[data-faq-button]"));
    faqButtons.forEach((button) => {
      button.addEventListener("click", () => {
        const panel = button.parentElement?.querySelector("[data-faq-panel]");
        const icon = button.querySelector("[data-faq-icon]");
        const isOpen = button.getAttribute("aria-expanded") === "true";
        faqButtons.forEach((other) => {
          other.setAttribute("aria-expanded", "false");
          const otherPanel = other.parentElement?.querySelector("[data-faq-panel]");
          if (otherPanel) otherPanel.hidden = true;
          const otherIcon = other.querySelector("[data-faq-icon]");
          if (otherIcon) otherIcon.textContent = "+";
        });
        if (!isOpen && panel) {
          button.setAttribute("aria-expanded", "true");
          panel.hidden = false;
          if (icon) icon.textContent = "−";
        }
      });
    });
    void reduceMotion;
  </script>
</BaseLayout>
