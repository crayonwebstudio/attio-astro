---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Drill down into your reporting data, copy fetched live from https://attio.com/changelog/2024/drill-down-into-your-reporting-data
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2024/drill-down-into-your-reporting-data");
if (!entry) throw new Error("Missing changelog data for /changelog/2024/drill-down-into-your-reporting-data");
---

<ChangelogEntry entry={entry} />
