---
import HelpLesson from "../../../../components/HelpLesson.astro";
import help from "../../../../data/help.json";

// Insight reports, copy fetched live from https://attio.com/help/academy/reports-course/insight-reports
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "academy/reports-course/insight-reports");
if (!entry) throw new Error("Missing help data for academy/reports-course/insight-reports");
---

<HelpLesson entry={entry} />
