---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// How we chose the name Attio, copy fetched live from https://attio.com/blog/how-we-chose-the-name-attio
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "how-we-chose-the-name-attio");
if (!post) throw new Error("Missing post data for how-we-chose-the-name-attio");
---

<BlogPost post={post} />
