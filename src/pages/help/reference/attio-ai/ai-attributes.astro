---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// AI attributes, copy fetched live from https://attio.com/help/reference/attio-ai/ai-attributes
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/attio-ai/ai-attributes");
if (!entry) throw new Error("Missing help data for reference/attio-ai/ai-attributes");
---

<HelpArticle entry={entry} />
