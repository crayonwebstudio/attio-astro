---
// Renders a run of inline segments (plain, bold, or linked) exactly as
// live renders them. Segment edge spaces are preserved in the data, so
// segments are rendered verbatim, no spaces added or stripped.
interface Segment {
  t: string;
  b?: boolean;
  href?: string;
}

interface Props {
  segments: Segment[];
}

const { segments } = Astro.props;
---

{segments.map((part) =>
  part.href ? (
    <a
      href={part.href}
      target={part.href.startsWith("http") ? "_blank" : undefined}
      rel={part.href.startsWith("http") ? "noopener noreferrer" : undefined}
      class="text-blue-500 underline underline-offset-2 hover:text-blue-600"
    >
      {part.t}
    </a>
  ) : part.b ? (
    <strong class="font-semibold">{part.t}</strong>
  ) : (
    part.t
  )
)}
