---
import HelpLesson from "../../../components/HelpLesson.astro";
import help from "../../../data/help.json";

// Creating sequences, copy fetched live from https://attio.com/help/academy/sequences
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "academy/sequences");
if (!entry) throw new Error("Missing help data for academy/sequences");
---

<HelpLesson entry={entry} />
