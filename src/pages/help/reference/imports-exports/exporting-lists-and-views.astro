---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Export lists and views, copy fetched live from https://attio.com/help/reference/imports-exports/exporting-lists-and-views
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/imports-exports/exporting-lists-and-views");
if (!entry) throw new Error("Missing help data for reference/imports-exports/exporting-lists-and-views");
---

<HelpArticle entry={entry} />
