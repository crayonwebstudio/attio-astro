---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for BubblaV, copy fetched live from https://attio.com/apps/bubbla-v
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "bubbla-v");
if (!app) throw new Error("Missing app detail: bubbla-v");
---

<AppDetail app={app} />
