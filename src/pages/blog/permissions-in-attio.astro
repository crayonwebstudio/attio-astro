---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Permissions in Attio, copy fetched live from https://attio.com/blog/permissions-in-attio
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "permissions-in-attio");
if (!post) throw new Error("Missing post data for permissions-in-attio");
---

<BlogPost post={post} />
