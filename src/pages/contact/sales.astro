---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Copy fetched live from https://attio.com/contact/sales on 2026-11-16 (HTTP 200, 347KB).
// H1 "Talk to Sales", H2 "See Attio in action.", subcopy, Seedcamp testimonial, and all
// form fields are live copy. The form is JS-rendered on live, so the field list, option
// lists, validation strings, and the multi-step flow were verified from the live HTML
// and the embedded i18n dictionary (talkToSalesForm, talkToSalesFlow, talkToSalesPhoneForm).
// Region options: Europe, North America, Rest of World. Number of users: 1 to 5, 6 to 10,
// 11 to 20, 21 to 50, 51 to 100, 101+. Flow: submit form, phone step ("Thanks, {firstName}!"),
// then success ("We'll be in touch soon!"). The form has no backend; submit only shows
// the client-side confirmation states. Live has no standard FinalCta ("Agentic revenue
// runs on Attio." appears 0 times in the live HTML), so hideFinalCta is used.
// No Attio images or fonts are hotlinked or copied.
const regions = ["Europe", "North America", "Rest of World"];
const teamSizes = ["1 to 5", "6 to 10", "11 to 20", "21 to 50", "51 to 100", "101+"];
---

<BaseLayout
  title="Talk to Sales | Attio"
  description="See how Attio can power your GTM motion with a product expert."
  hideFinalCta
>
  <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
    <div class="grid gap-0 lg:grid-cols-2">
      <!-- Left: header + testimonial -->
      <section class="pb-16 pt-16 sm:pt-24 lg:pr-16" aria-label="Talk to Sales">
        <div class="inline-block w-fit rounded-[13px] border border-paper-500 bg-white px-3 py-1.5 text-[13px] font-medium leading-[1.4em] text-ink-600">
          <h1 class="inline font-medium">Talk to Sales</h1>
        </div>
        <h2 class="mt-6 max-w-[15em] font-display text-heading-lg font-semibold leading-[1.05] tracking-tight">
          See Attio in action.
        </h2>
        <p class="mt-4 max-w-xl text-lg leading-relaxed text-ink-600 sm:text-xl">
          Get in touch to explore how Attio can power your GTM motion.
        </p>

        <!-- Testimonial, desktop: under the header -->
        <blockquote class="mt-16 hidden max-w-[24em] lg:block">
          <p class="relative font-serif text-2xl leading-snug text-ink-100">
            <span class="absolute -translate-x-full">&ldquo;</span>Right from the outset we&rsquo;ve felt so
            supported by the team &ndash; all the way through discovery, onboarding, and then ongoing customer
            support.&rdquo;
          </p>
          <p class="mt-4 text-sm text-ink-600">
            <span class="font-bold text-ink-100">Miguel Pinho</span><br />Head of Technology &middot; Seedcamp
          </p>
        </blockquote>
      </section>

      <!-- Right: form -->
      <section class="border-t border-paper-400 bg-paper-200 px-6 py-16 sm:px-10 sm:py-20 lg:border-l lg:border-t-0" aria-label="Request a demo">
        <!-- Step 1: form -->
        <form id="talk-to-sales-form" novalidate>
          <div class="flex flex-col gap-y-5">
            <div class="grid grid-cols-2 gap-x-5 gap-y-3 max-md:grid-cols-1">
              <div class="flex flex-col gap-y-1.5">
                <label class="text-xs text-ink-600" for="firstName">First name</label>
                <input
                  class="block w-full rounded-[10px] border border-paper-500 bg-white p-[10px_13px] text-sm text-ink-100 outline-none placeholder:text-ink-700 hover:shadow-[0px_1px_4px_rgba(56,62,71,0.1)] focus-visible:border-blue-500 focus-visible:ring-[3px] focus-visible:ring-blue-300"
                  type="text"
                  placeholder="First"
                  id="firstName"
                  name="firstName"
                  autocomplete="given-name"
                />
                <p class="hidden text-xs text-red-600" data-error-for="firstName">Please enter your first name</p>
              </div>
              <div class="flex flex-col gap-y-1.5">
                <label class="text-xs text-ink-600" for="lastName">Last name</label>
                <input
                  class="block w-full rounded-[10px] border border-paper-500 bg-white p-[10px_13px] text-sm text-ink-100 outline-none placeholder:text-ink-700 hover:shadow-[0px_1px_4px_rgba(56,62,71,0.1)] focus-visible:border-blue-500 focus-visible:ring-[3px] focus-visible:ring-blue-300"
                  type="text"
                  placeholder="Last"
                  id="lastName"
                  name="lastName"
                  autocomplete="family-name"
                />
                <p class="hidden text-xs text-red-600" data-error-for="lastName">Please enter your last name</p>
              </div>
            </div>
            <div class="flex flex-col gap-y-1.5">
              <label class="text-xs text-ink-600" for="companyEmail">Company email</label>
              <input
                class="block w-full rounded-[10px] border border-paper-500 bg-white p-[10px_13px] text-sm text-ink-100 outline-none placeholder:text-ink-700 hover:shadow-[0px_1px_4px_rgba(56,62,71,0.1)] focus-visible:border-blue-500 focus-visible:ring-[3px] focus-visible:ring-blue-300"
                type="email"
                placeholder="Your work email"
                id="companyEmail"
                name="companyEmail"
                autocomplete="email"
              />
              <p class="hidden text-xs text-red-600" data-error-for="companyEmail">Please enter your work email</p>
            </div>
            <div class="grid grid-cols-2 gap-x-5 gap-y-5 max-md:grid-cols-1">
              <div class="flex flex-col gap-y-1.5">
                <label class="text-xs text-ink-600" for="region">Region</label>
                <select
                  class="block w-full cursor-pointer appearance-none rounded-[10px] border border-paper-500 bg-white p-[10px_13px] text-sm text-ink-100 outline-none hover:shadow-[0px_1px_4px_rgba(56,62,71,0.1)] focus-visible:border-blue-500 focus-visible:ring-[3px] focus-visible:ring-blue-300"
                  id="region"
                  name="region"
                >
                  <option value="" selected>Select</option>
                  {regions.map((region) => <option value={region}>{region}</option>)}
                </select>
                <p class="hidden text-xs text-red-600" data-error-for="region">Please select your region</p>
              </div>
              <div class="flex flex-col gap-y-1.5">
                <label class="text-xs text-ink-600" for="companySize">Number of users</label>
                <select
                  class="block w-full cursor-pointer appearance-none rounded-[10px] border border-paper-500 bg-white p-[10px_13px] text-sm text-ink-100 outline-none hover:shadow-[0px_1px_4px_rgba(56,62,71,0.1)] focus-visible:border-blue-500 focus-visible:ring-[3px] focus-visible:ring-blue-300"
                  id="companySize"
                  name="companySize"
                >
                  <option value="" selected>Select</option>
                  {teamSizes.map((size) => <option value={size}>{size}</option>)}
                </select>
                <p class="hidden text-xs text-red-600" data-error-for="companySize">Please select your company size</p>
              </div>
            </div>
            <div class="flex flex-col gap-y-1.5">
              <label class="text-xs text-ink-600" for="details">Details</label>
              <textarea
                class="block w-full rounded-[10px] border border-paper-500 bg-white p-[10px_13px] text-sm text-ink-100 outline-none placeholder:text-ink-700 hover:shadow-[0px_1px_4px_rgba(56,62,71,0.1)] focus-visible:border-blue-500 focus-visible:ring-[3px] focus-visible:ring-blue-300"
                rows="3"
                placeholder="Tell us about your needs and questions"
                id="details"
                name="details"></textarea>
              <p class="hidden text-xs text-red-600" data-error-for="details">Please tell us how we can help</p>
            </div>
          </div>
          <button
            type="submit"
            class="mt-7 h-11 w-full cursor-pointer rounded-xl bg-ink-100 px-3.5 text-base font-semibold text-white transition-colors hover:bg-ink-300"
          >
            Submit
          </button>
        </form>
        <p class="mt-6 max-w-[36em] text-xs leading-relaxed text-ink-600">This site is protected by reCAPTCHA and the Google <a href="https://policies.google.com/privacy" class="underline">Privacy Policy</a> and <a href="https://policies.google.com/terms" class="underline">Terms of Service</a> apply.</p>

        <!-- Step 2: phone step -->
        <div id="phone-step" class="hidden">
          <h2 class="font-display text-heading-sm font-semibold tracking-tight" id="phone-step-title">Thanks!</h2>
          <p class="mt-3 text-base leading-relaxed text-ink-600">
            We&rsquo;ve got your request. Prefer a call to an email? Leave your number.
          </p>
          <form id="phone-form" class="mt-6" novalidate>
            <div class="flex flex-col gap-y-1.5">
              <label class="text-xs text-ink-600" for="phoneNumber">Phone number</label>
              <input
                class="block w-full rounded-[10px] border border-paper-500 bg-white p-[10px_13px] text-sm text-ink-100 outline-none placeholder:text-ink-700 hover:shadow-[0px_1px_4px_rgba(56,62,71,0.1)] focus-visible:border-blue-500 focus-visible:ring-[3px] focus-visible:ring-blue-300"
                type="tel"
                placeholder="+1 202 555 0123"
                id="phoneNumber"
                name="phoneNumber"
                autocomplete="tel"
              />
              <p class="hidden text-xs text-red-600" data-error-for="phoneNumber">
                Please enter a valid phone number in international format (e.g., +1 202 555 0123)
              </p>
            </div>
            <button
              type="submit"
              class="mt-7 h-11 w-full cursor-pointer rounded-xl bg-ink-100 px-3.5 text-base font-semibold text-white transition-colors hover:bg-ink-300"
            >
              Call me
            </button>
            <button
              type="button"
              id="skip-phone"
              class="mt-3 h-11 w-full cursor-pointer rounded-xl border border-paper-500 bg-white px-3.5 text-base font-semibold text-ink-100 transition-colors hover:bg-paper-200"
            >
              Skip
            </button>
          </form>
        </div>

        <!-- Step 3: success -->
        <div id="success-step" class="hidden">
          <h2 class="font-display text-heading-sm font-semibold tracking-tight" id="success-title">
            We&rsquo;ll be in touch soon!
          </h2>
          <p class="mt-3 text-base leading-relaxed text-ink-600" id="success-body">Our team will be in touch soon. If you have any questions, please email us at <a href="mailto:sales@attio.com" class="font-medium text-ink-100 underline underline-offset-4">sales@attio.com</a>.</p>
        </div>
      </section>

      <!-- Testimonial, mobile: below the form -->
      <blockquote class="max-w-[24em] pb-16 lg:hidden">
        <p class="relative font-serif text-2xl leading-snug text-ink-100">
          <span class="absolute -translate-x-full">&ldquo;</span>Right from the outset we&rsquo;ve felt so
          supported by the team &ndash; all the way through discovery, onboarding, and then ongoing customer
          support.&rdquo;
        </p>
        <p class="mt-4 text-sm text-ink-600">
          <span class="font-bold text-ink-100">Miguel Pinho</span><br />Head of Technology &middot; Seedcamp
        </p>
      </blockquote>
    </div>
  </div>

  <script>
    const form = document.getElementById("talk-to-sales-form");
    const phoneStep = document.getElementById("phone-step");
    const phoneForm = document.getElementById("phone-form");
    const successStep = document.getElementById("success-step");
    const phoneStepTitle = document.getElementById("phone-step-title");
    const successTitle = document.getElementById("success-title");
    const successBody = document.getElementById("success-body");
    const skipPhone = document.getElementById("skip-phone");
    const recaptchaNote = form ? form.nextElementSibling : null;

    function showError(field, message) {
      const input = document.getElementById(field);
      const error = document.querySelector('[data-error-for="' + field + '"]');
      if (input) input.setAttribute("aria-invalid", "true");
      if (error) {
        if (message) error.textContent = message;
        error.classList.remove("hidden");
      }
    }

    function clearError(field) {
      const input = document.getElementById(field);
      const error = document.querySelector('[data-error-for="' + field + '"]');
      if (input) input.setAttribute("aria-invalid", "false");
      if (error) error.classList.add("hidden");
    }

    function isWorkEmail(value) {
      const parts = value.split("@");
      if (parts.length !== 2 || !parts[0] || !parts[1]) return "invalid";
      const domain = parts[1].toLowerCase();
      if (domain.indexOf(".") === -1) return "invalid";
      const freeDomains = ["gmail.com", "yahoo.com", "hotmail.com", "outlook.com", "icloud.com", "aol.com", "protonmail.com", "proton.me", "mail.com", "gmx.com"];
      if (freeDomains.indexOf(domain) !== -1) return "work";
      return "ok";
    }

    form.addEventListener("submit", function (event) {
      event.preventDefault();
      let valid = true;
      const firstName = document.getElementById("firstName").value.trim();
      const lastName = document.getElementById("lastName").value.trim();
      const companyEmail = document.getElementById("companyEmail").value.trim();
      const region = document.getElementById("region").value;
      const companySize = document.getElementById("companySize").value;
      const details = document.getElementById("details").value.trim();

      if (!firstName) { showError("firstName"); valid = false; } else { clearError("firstName"); }
      if (!lastName) { showError("lastName"); valid = false; } else { clearError("lastName"); }
      if (!companyEmail) {
        showError("companyEmail", "Please enter your work email");
        valid = false;
      } else {
        const check = isWorkEmail(companyEmail);
        if (check === "invalid") { showError("companyEmail", "Please enter a valid email address"); valid = false; }
        else if (check === "work") { showError("companyEmail", "Please provide a work email address (e.g. you@company.com)"); valid = false; }
        else { clearError("companyEmail"); }
      }
      if (!region) { showError("region"); valid = false; } else { clearError("region"); }
      if (!companySize) { showError("companySize"); valid = false; } else { clearError("companySize"); }
      if (!details) { showError("details"); valid = false; } else { clearError("details"); }
      if (!valid) return;

      phoneStepTitle.textContent = "Thanks, " + firstName + "!";
      form.classList.add("hidden");
      if (recaptchaNote) recaptchaNote.classList.add("hidden");
      phoneStep.classList.remove("hidden");
    });

    function showSuccess() {
      const isMobile = window.innerWidth < 1024;
      if (isMobile) {
        successTitle.textContent = "We've received your application!";
        successBody.innerHTML =
          'Our team will review your application shortly. If you have any questions, please email us at <a href="mailto:sales@attio.com" class="font-medium text-ink-100 underline underline-offset-4">sales@attio.com</a>.';
      }
      phoneStep.classList.add("hidden");
      successStep.classList.remove("hidden");
    }

    phoneForm.addEventListener("submit", function (event) {
      event.preventDefault();
      const phone = document.getElementById("phoneNumber").value.trim();
      if (!phone) { showSuccess(); return; }
      if (!/^\+?[0-9\s().-]{7,}$/.test(phone)) {
        showError("phoneNumber");
        return;
      }
      clearError("phoneNumber");
      showSuccess();
    });

    skipPhone.addEventListener("click", function () {
      showSuccess();
    });
  </script>
</BaseLayout>
