---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Notes on mobile, copy fetched live from https://attio.com/changelog/2021/notes-on-mobile
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2021/notes-on-mobile");
if (!entry) throw new Error("Missing changelog data for /changelog/2021/notes-on-mobile");
---

<ChangelogEntry entry={entry} />
