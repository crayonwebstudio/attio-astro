---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// New integrations: Cardinal, Circleback, and more, copy fetched live from https://attio.com/changelog/2024/new-integrations-cardinal-circleback-and-more
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2024/new-integrations-cardinal-circleback-and-more");
if (!entry) throw new Error("Missing changelog data for /changelog/2024/new-integrations-cardinal-circleback-and-more");
---

<ChangelogEntry entry={entry} />
