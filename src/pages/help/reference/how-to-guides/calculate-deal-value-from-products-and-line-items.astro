---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Automatically calculate deal value from products and line items, copy fetched live from https://attio.com/help/reference/how-to-guides/calculate-deal-value-from-products-and-line-items
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/how-to-guides/calculate-deal-value-from-products-and-line-items");
if (!entry) throw new Error("Missing help data for reference/how-to-guides/calculate-deal-value-from-products-and-line-items");
---

<HelpArticle entry={entry} />
