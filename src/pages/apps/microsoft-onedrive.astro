---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Microsoft OneDrive, copy fetched live from https://attio.com/apps/microsoft-onedrive
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "microsoft-onedrive");
if (!app) throw new Error("Missing app detail: microsoft-onedrive");
---

<AppDetail app={app} />
