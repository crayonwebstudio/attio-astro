---
import WorkflowTemplate from "../../../components/WorkflowTemplate.astro";
import templates from "../../../data/templates.json";

// Lost deal summary, copy fetched live from https://attio.com/templates/sales/lost-deal-summary
// on 2026-11-17 (HTTP 200). Data lives in src/data/templates.json.
const entry = (templates as any[]).find((entry) => entry.path === "/templates/sales/lost-deal-summary");
if (!entry) throw new Error("Missing template data for /templates/sales/lost-deal-summary");
---

<WorkflowTemplate entry={entry} />
