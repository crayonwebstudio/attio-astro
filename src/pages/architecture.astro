---
import BaseLayout from "../layouts/BaseLayout.astro";

// Copy fetched live from https://attio.com/architecture on 2026-11-17 (HTTP 200).
// Live H1 is "Agents are breaking your software."; the live H1 element also
// contains two more rotating lines ("The old architecture was never intended
// for them." and "GTM needs a new architecture."), rendered here as a rotating
// headline. Live has no standard FinalCta ("Agentic revenue runs on Attio."
// appears 0 times in the live HTML), so hideFinalCta is used; the page closes
// with its own "Talk to us" / "Get started" buttons. Live images
// (agent-person.webp, person-1/2/3.webp, system-person.webp) are rendered as
// CSS mock panels, not copied. Frontier logos are text wordmarks.
const reasons = [
  {
    n: "01",
    title: "Scale",
    body: "For every one record a human might check, an agent can read thousands. Software built for human traffic can\u2019t carry that load.",
  },
  {
    n: "02",
    title: "Context",
    body: "Agents are only as good as the context you give them. They\u2019ll read and act on whatever they can find, even if it\u2019s only half the picture.",
  },
  {
    n: "03",
    title: "Interface",
    body: "Agents need an interface that represents the rules and validations of the system without the overhead of UI made for people.",
  },
  {
    n: "04",
    title: "Language",
    body: "Agents are trained to use common coding techniques. Proprietary languages and complex UI don\u2019t make sense to them.",
  },
  {
    n: "05",
    title: "Permissions",
    body: "Agents require a different kind of identity to people. They need to see deeper context than a person would, but for a much narrower slice.",
  },
];

const pillars = [
  {
    n: "01",
    title: "Context",
    body: "Every customer signal is captured in one shared context layer for your team and agents. It\u2019s high-resolution, always current, continuously compounding, and rich enough to act on.",
  },
  {
    n: "02",
    title: "Orchestration",
    body: "Agents cover every motion your revenue team needs to run, supported by the context layer. They act on the right signals the moment they appear.",
  },
  {
    n: "03",
    title: "Ecosystem",
    body: "Attio reaches wherever you and your agents operate. It\u2019s extensible by default, with first-class agentic access on every surface, held to the same standard everywhere.",
  },
];
---

<BaseLayout
  title="The architecture for agentic revenue | Attio"
  description="Agents are breaking your software. The old architecture was never intended for them. GTM needs a new architecture."
  hideFinalCta
>
  <!-- Hero: rotating H1 lines as on live -->
  <section class="mx-auto max-w-[1200px] px-4 pb-16 pt-16 text-center sm:px-6 sm:pt-24">
    <h1 class="mx-auto max-w-4xl font-display text-[56px] font-semibold leading-[1.05] tracking-tight sm:text-[72px]">
      <span class="hero-line" data-line="0">Agents are breaking your software.</span>
      <span class="hero-line hidden" data-line="1">The old architecture was never intended for them.</span>
      <span class="hero-line hidden" data-line="2">GTM needs a new architecture.</span>
    </h1>
    <!-- agent-person image: CSS mock panel -->
    <div class="mx-auto mt-14 flex min-h-[280px] max-w-4xl flex-col items-center justify-center gap-4 overflow-hidden rounded-2xl border border-paper-500 bg-ink-100 px-6 py-16 text-center sm:min-h-[360px]">
      <p class="font-display text-4xl font-semibold tracking-tight text-white sm:text-5xl">attio</p>
      <p class="max-w-md text-sm leading-relaxed text-white/70">
        The architecture for agentic revenue, rendered as a placeholder panel. The live image is not copied.
      </p>
    </div>
  </section>

  <!-- The story -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="The story">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-500">[The story]</p>
    <h2 class="mt-6 max-w-3xl font-display text-heading-md font-semibold tracking-tight">
      For thirty years, software has come in two shapes.
    </h2>
    <div class="mt-6 max-w-3xl space-y-5 text-lg leading-relaxed text-ink-600">
      <p>Introduction</p>
      <p>
        Application software was built for people. It was safe and forgiving, with the aim of enabling low
        volumes of high-context, non-deterministic work. It didn&rsquo;t matter that it was slow, because people
        could only move so fast, and there was a limit to the work that could be done.
      </p>
      <p>
        Infrastructure was built to be driven by machines. It was fast, complex, and designed for deterministic
        work at scale. You could query millions of rows and get answers in seconds, but only for predetermined
        questions about highly structured data.
      </p>
      <p class="font-display text-2xl font-semibold tracking-tight text-ink-100">
        Neither shape was built for agents.
      </p>
    </div>

    <h3 class="mt-14 max-w-3xl font-display text-heading-sm font-semibold tracking-tight">
      An agent can do the high context work of a person at the speed and scale of a machine.
    </h3>
    <div class="mt-6 max-w-3xl space-y-5 text-lg leading-relaxed text-ink-600">
      <p>
        Agents unlock previously impossible customer experiences at unprecedented scale, and provide a radically
        personalized customer experience, freeing your team to focus on the highest leverage work. An agent can
        assist every customer relationship, hold more context than any single person could, and find growth
        opportunities that you couldn&rsquo;t see before.
      </p>
      <p>
        In the history of software, there&rsquo;s never been a better time to be unreasonably ambitious about what
        you can achieve, and there is so much more potential.
      </p>
    </div>

    <h3 class="mt-14 max-w-3xl font-display text-heading-sm font-semibold tracking-tight">
      But we&rsquo;re only scratching the surface.
    </h3>
    <div class="mt-6 max-w-3xl space-y-5 text-lg leading-relaxed text-ink-600">
      <p>To realize this potential and build context at scale, agents need more than any system of record was built to provide.</p>
      <p>
        People build context by consuming an extraordinary amount of information. We read emails, listen to calls,
        and message each other on Slack. That information lets us provide great customer experiences, and the
        system of record was the artifact we created with that context.
      </p>
      <p>
        For agents to deliver these experiences, they need to centralize and index all of that disparate,
        unstructured data, within the system of record.
      </p>
      <p>
        The problem is that this rich context exceeds what those systems can store, and forces agents to use
        infrastructure instead. Infrastructure wasn&rsquo;t built for this. Infrastructure doesn&rsquo;t offer the
        guardrails, observability, or validation that you need. Agents are constrained by the limitations of our
        tools.
      </p>
      <p>There are five reasons why:</p>
    </div>

    <!-- Five reasons accordion -->
    <div class="mt-8 max-w-3xl" id="reasons">
      {
        reasons.map((reason, i) => (
          <div class="border-b border-paper-500 py-6 first:pt-0">
            <button
              type="button"
              data-reason={i}
              class="flex w-full items-center justify-between gap-4 text-left font-display text-2xl font-semibold tracking-tight"
              aria-expanded={i === 0 ? "true" : "false"}
            >
              <span>
                {reason.title} <span class="text-base font-medium text-ink-700">[{reason.n}]</span>
              </span>
              <span class="text-lg font-normal text-ink-700" aria-hidden="true">{i === 0 ? "\u2212" : "+"}</span>
            </button>
            <p class={`reason-body mt-3 leading-relaxed text-ink-600 ${i === 0 ? "" : "hidden"}`}>{reason.body}</p>
          </div>
        ))
      }
    </div>

    <p class="mt-14 text-sm font-semibold uppercase tracking-[0.2em] text-blue-500">The problem</p>
    <div class="mt-6 max-w-3xl space-y-5 text-lg leading-relaxed text-ink-600">
      <p>
        Every CRM is built as application software, and inherits these problems. All were built for a person,
        and all are about to be driven by something that is not one.
      </p>
      <p>Software has never mattered more, yet it&rsquo;s never been less prepared.</p>
    </div>
    <h3 class="mt-10 max-w-3xl font-display text-heading-sm font-semibold tracking-tight">
      Power at this scale needs something that has never existed before.
    </h3>
    <ul class="mt-6 max-w-3xl space-y-3 text-lg leading-relaxed text-ink-600">
      <li class="flex items-start gap-3">
        <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500" aria-hidden="true" />
        A new architecture with the guardrails of application software and the throughput of infrastructure.
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500" aria-hidden="true" />
        A single system, equally built for people and agents.
      </li>
      <li class="flex items-start gap-3">
        <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-blue-500" aria-hidden="true" />
        GTM needs a new shape of software.
      </li>
    </ul>
  </section>

  <!-- The architecture -->
  <section class="bg-ink-100 py-20 text-white" aria-label="The architecture">
    <div class="mx-auto max-w-[1200px] px-4 sm:px-6">
      <p class="text-sm font-semibold uppercase tracking-[0.2em] text-white/60">[The architecture]</p>
      <h2 class="mt-6 max-w-3xl font-display text-heading-md font-semibold tracking-tight">
        This is the architecture for agentic revenue.
      </h2>
      <h3 class="mt-10 font-display text-heading-sm font-semibold tracking-tight">The next phase of Attio.</h3>
      <div class="mt-6 max-w-3xl space-y-5 text-lg leading-relaxed text-white/80">
        <p>
          Attio is a hybrid system, architected for people and agents in equal measure, with the control of
          application software and the scale of infrastructure.
        </p>
        <p>
          GTM teams have always had to choose between speed, scale, and quality. We removed the choice. Attio
          works at the speed of an agent, across your entire market, to the standard of your best rep. That is an
          order of magnitude more value from your time, because each task an agent completes leaves context
          behind for the next one, so that context compounds. The longer it runs, the sharper it gets.
        </p>
      </div>
      <h3 class="mt-14 font-display text-heading-sm font-semibold tracking-tight">
        This is what we&rsquo;ve always been building.
      </h3>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {
          pillars.map((pillar) => (
            <div class="rounded-2xl border border-white/15 bg-white/5 p-8">
              <h4 class="font-display text-2xl font-semibold tracking-tight">
                {pillar.title} <span class="text-base font-medium text-white/60">[{pillar.n}]</span>
              </h4>
              <p class="mt-3 leading-relaxed text-white/80">{pillar.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- The launch -->
  <section class="mx-auto max-w-[1200px] px-4 py-20 sm:px-6" aria-label="The launch">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-500">[The launch]</p>
    <h2 class="mt-6 max-w-3xl font-display text-heading-md font-semibold tracking-tight">
      Introducing the next phase.
    </h2>

    <div class="mt-12 grid gap-6 md:grid-cols-2">
      <article class="rounded-2xl border border-paper-500 bg-white p-8">
        <h3 class="font-display text-heading-sm font-semibold tracking-tight">SQL Engine</h3>
        <p class="mt-2 text-sm font-medium text-ink-700">[A team of data scientists on every question.]</p>
        <div class="mt-4 space-y-4 leading-relaxed text-ink-600">
          <p>
            Attio now speaks SQL, the data language of agents. They use it to reason across millions of records,
            objects, and relationships at once. Complex joins, calculations, and aggregations now run natively in
            Attio.
          </p>
          <p>
            Ask questions no predefined endpoint can answer. Calculate weighted forecasts, compare win rates, or
            measure your progress against targets in one query. Attio will perform the computation itself and
            return an exact result, keeping every query visible for you to inspect.
          </p>
        </div>
      </article>
      <article class="rounded-2xl border border-paper-500 bg-white p-8">
        <h3 class="font-display text-heading-sm font-semibold tracking-tight">Data Connectors</h3>
        <p class="mt-2 text-sm font-medium text-ink-700">[Skip the sync and go straight to the source.]</p>
        <div class="mt-4 space-y-4 leading-relaxed text-ink-600">
          <p>
            Attio now exposes a live, Postgres-compatible endpoint, connecting your CRM directly to your agents
            and your data stack in realtime.
          </p>
          <p>
            Build dashboards, run complex analyses, and let agents query live customer data without exports, data
            warehouses, or nightly syncs. All your data stays live, consistent and readable straight from the
            source.
          </p>
        </div>
      </article>
      <article class="rounded-2xl border border-paper-500 bg-white p-8">
        <h3 class="font-display text-heading-sm font-semibold tracking-tight">Agent Scale</h3>
        <p class="mt-2 text-sm font-medium text-ink-700">[Thousands of agents. Zero traffic jams.]</p>
        <div class="mt-4 space-y-4 leading-relaxed text-ink-600">
          <p>
            Attio is engineered to support hundreds of millions of records and retrieve them at agent scale.
          </p>
          <p>
            Research every account in your market at once and re-qualify entire pipelines overnight. As your
            business changes, keep millions of records current with thousands of agents reading, reasoning, and
            acting with the same permissions as the people they work with.
          </p>
        </div>
      </article>
      <article class="rounded-2xl border border-paper-500 bg-white p-8">
        <div class="flex items-start justify-between gap-3">
          <h3 class="font-display text-heading-sm font-semibold tracking-tight">Activities</h3>
          <span class="flex gap-2">
            <span class="rounded-full bg-paper-200 px-2.5 py-1 text-xs font-semibold text-ink-700">[Beta]</span>
            <span class="rounded-full bg-paper-200 px-2.5 py-1 text-xs font-semibold text-ink-700">[Beta]</span>
          </span>
        </div>
        <p class="mt-2 text-sm font-medium text-ink-700">[If it moves the deal, it&rsquo;s on the record.]</p>
        <div class="mt-4 space-y-4 leading-relaxed text-ink-600">
          <p>
            Your customers show up in more places than just your inbox. With Attio, pull in support tickets,
            social DMs, product events, and whatever else moves your deals. Custom schemas let you capture the
            details unique to every interaction.
          </p>
          <p>
            Each activity becomes structured, first-class data on the relevant record, giving your team a more
            complete understanding of every relationship, and your agents the context they need to act on it.
          </p>
        </div>
      </article>
    </div>

    <h3 class="mt-20 font-display text-heading-sm font-semibold tracking-tight">
      The companies at the frontier have already chosen Attio.
    </h3>
    <div class="mt-8 flex flex-wrap items-center gap-x-10 gap-y-4 text-xl font-semibold text-ink-700">
      <span>Granola</span>
      <span>Modal</span>
      <span>Wordsmith</span>
      <span>turbopuffer</span>
    </div>

    <div class="mt-20 text-center">
      <h2 class="mx-auto max-w-3xl font-display text-heading-md font-semibold tracking-tight">
        There has never been a better time to be unreasonably ambitious
      </h2>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/contact/sales"
          class="rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
        >
          Talk to us
        </a>
        <a
          href="/go/welcome/sign-in"
          class="rounded-full border border-ink-100 px-6 py-3 text-sm font-semibold text-ink-100 hover:bg-paper-200"
        >
          Get started
        </a>
      </div>
    </div>
  </section>

  <script>
    // Rotating hero headline: the live H1 cycles through three lines.
    const lines = Array.from(document.querySelectorAll(".hero-line"));
    let current = 0;
    if (lines.length > 1) {
      setInterval(() => {
        lines[current].classList.add("hidden");
        current = (current + 1) % lines.length;
        lines[current].classList.remove("hidden");
      }, 4000);
    }
    // Five reasons accordion: one open at a time.
    document.querySelectorAll("[data-reason]").forEach((button) => {
      button.addEventListener("click", () => {
        const container = document.getElementById("reasons");
        if (!container) return;
        const wasOpen = button.getAttribute("aria-expanded") === "true";
        container.querySelectorAll("[data-reason]").forEach((b) => {
          b.setAttribute("aria-expanded", "false");
          const icon = b.querySelector("span[aria-hidden]") as HTMLElement;
          if (icon) icon.textContent = "+";
        });
        container.querySelectorAll(".reason-body").forEach((body) => body.classList.add("hidden"));
        if (!wasOpen) {
          button.setAttribute("aria-expanded", "true");
          const icon = button.querySelector("span[aria-hidden]") as HTMLElement;
          if (icon) icon.textContent = "\u2212";
          const body = button.parentElement?.querySelector(".reason-body");
          body?.classList.remove("hidden");
        }
      });
    });
  </script>
</BaseLayout>
