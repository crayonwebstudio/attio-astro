---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Meeting and Call Recording APIs (Beta), copy fetched live from https://attio.com/changelog/2025/meeting-and-call-recording-apis-beta
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2025/meeting-and-call-recording-apis-beta");
if (!entry) throw new Error("Missing changelog data for /changelog/2025/meeting-and-call-recording-apis-beta");
---

<ChangelogEntry entry={entry} />
