---
import HelpCategory from "../../../../components/HelpCategory.astro";
import help from "../../../../data/help.json";

// Views, copy fetched live from https://attio.com/help/reference/managing-your-data/views
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/managing-your-data/views");
if (!entry) throw new Error("Missing help data for reference/managing-your-data/views");
---

<HelpCategory entry={entry} />
