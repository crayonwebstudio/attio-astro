---
import HelpArticle from "../../../../../components/HelpArticle.astro";
import help from "../../../../../data/help.json";

// Filter and sort views, copy fetched live from https://attio.com/help/reference/managing-your-data/views/filter-and-sort-views
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/managing-your-data/views/filter-and-sort-views");
if (!entry) throw new Error("Missing help data for reference/managing-your-data/views/filter-and-sort-views");
---

<HelpArticle entry={entry} />
