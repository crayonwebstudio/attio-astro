---
import EngineeringPost from "../../../components/EngineeringPost.astro";
import data from "../../../data/engineering.json";

// Building better software with AI, copy fetched live from https://attio.com/engineering/blog/building-better-software-with-ai
// on 2026-11-16 (HTTP 200). Data lives in src/data/engineering.json.
const post = data.posts.find((entry) => entry.slug === "building-better-software-with-ai");
if (!post) throw new Error("Missing engineering post data for building-better-software-with-ai");
---

<EngineeringPost post={post} />
