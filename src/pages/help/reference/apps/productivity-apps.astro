---
import HelpCategory from "../../../../components/HelpCategory.astro";
import help from "../../../../data/help.json";

// Productivity apps, copy fetched live from https://attio.com/help/reference/apps/productivity-apps
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/apps/productivity-apps");
if (!entry) throw new Error("Missing help data for reference/apps/productivity-apps");
---

<HelpCategory entry={entry} />
