---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Improved settings pages, copy fetched live from https://attio.com/changelog/2025/improved-settings-pages
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2025/improved-settings-pages");
if (!entry) throw new Error("Missing changelog data for /changelog/2025/improved-settings-pages");
---

<ChangelogEntry entry={entry} />
