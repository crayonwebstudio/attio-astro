---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Why Attio hires graduates, copy fetched live from https://attio.com/blog/why-attio-hires-graduates
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "why-attio-hires-graduates");
if (!post) throw new Error("Missing post data for why-attio-hires-graduates");
---

<BlogPost post={post} />
