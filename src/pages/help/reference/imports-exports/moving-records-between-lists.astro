---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Move records between lists, copy fetched live from https://attio.com/help/reference/imports-exports/moving-records-between-lists
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/imports-exports/moving-records-between-lists");
if (!entry) throw new Error("Missing help data for reference/imports-exports/moving-records-between-lists");
---

<HelpArticle entry={entry} />
