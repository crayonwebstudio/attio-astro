---
import ChangelogYear from "../../components/ChangelogYear.astro";
import data from "../../data/changelog-entries.json";

// Changelog 2025, copy fetched live from https://attio.com/changelog/2025
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const yearData = (data as any).years.find((year: any) => year.year === 2025);
if (!yearData) throw new Error("Missing changelog data for 2025");
---

<ChangelogYear yearData={yearData} />
