---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Sign in to Attio, copy fetched live from https://attio.com/help/reference/account-settings/signing-into-attio
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/account-settings/signing-into-attio");
if (!entry) throw new Error("Missing help data for reference/account-settings/signing-into-attio");
---

<HelpArticle entry={entry} />
