---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Comments and mentions, copy fetched live from https://attio.com/help/reference/productivity-collaborating/comments-and-mentions
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/productivity-collaborating/comments-and-mentions");
if (!entry) throw new Error("Missing help data for reference/productivity-collaborating/comments-and-mentions");
---

<HelpArticle entry={entry} />
