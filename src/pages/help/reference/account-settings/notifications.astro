---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Manage notifications, copy fetched live from https://attio.com/help/reference/account-settings/notifications
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/account-settings/notifications");
if (!entry) throw new Error("Missing help data for reference/account-settings/notifications");
---

<HelpArticle entry={entry} />
