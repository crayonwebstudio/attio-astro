---
import BaseLayout from "../layouts/BaseLayout.astro";
import HelpSidebar from "./HelpSidebar.astro";

// Shared layout for the 38 help category pages under /help/*
// (/help/academy, /help/reference, and their sub-categories).
// Copy fetched live from https://attio.com/help/* on 2026-11-16 (HTTP 200
// each), stored in src/data/help.json. All titles, descriptions, and child
// links are live Attio copy. Live em dashes are rendered as commas, per
// the no em dash rule. Live help pages have no standard FinalCta
// ("Agentic revenue runs on Attio." appears 0 times in the live HTML), so
// this layout hides the shared FinalCta. Top-level categories render their
// children as cards, sub-categories as a list, as on live.

interface Props {
  entry: any;
}

const { entry } = Astro.props;
const crumbs = [...(entry.breadcrumb ?? []), { t: entry.h1, href: null }];
const isTopLevel = entry.slug === "academy" || entry.slug === "reference";
---

<BaseLayout title={`${entry.title} | Attio Help Center`} description={entry.description} hideFinalCta>
  <div class="mx-auto grid max-w-[1200px] lg:grid-cols-[260px_1fr]">
    <HelpSidebar current={entry.path} />

    <div class="min-w-0 px-4 pb-24 sm:px-6 lg:pl-10">
      <!-- Breadcrumb -->
      <nav class="flex h-9 items-center gap-1.5 pt-10 text-sm text-ink-600" aria-label="Breadcrumb">
        {crumbs.map((crumb: any, i: number) => (
          <>
            {i > 0 && <span aria-hidden="true">/</span>}
            {crumb.href ? (
              <a href={crumb.href} class="hover:text-blue-500 hover:underline">
                {crumb.t}
              </a>
            ) : (
              <span class="font-medium text-ink-100">{crumb.t}</span>
            )}
          </>
        ))}
      </nav>

      <!-- Header -->
      <header class="mt-10">
        <h1 class="font-display text-[40px] font-semibold leading-[1.05] tracking-tight text-ink-100 sm:text-[56px]">
          {entry.h1}
        </h1>
        {entry.desc && (
          <p class="mt-6 max-w-[36em] text-lg leading-relaxed text-ink-600">{entry.desc}</p>
        )}
      </header>

      <!-- Children -->
      {isTopLevel ? (
        <ul class="mt-20 grid gap-6 sm:grid-cols-2">
          {entry.children.map((child: any) => (
            <li>
              <a
                href={child.href}
                class="group flex h-full flex-col gap-1 overflow-hidden rounded-2xl border border-paper-500 bg-white p-6 transition-shadow hover:shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)]"
              >
                <h3 class="font-display text-xl font-semibold tracking-tight text-ink-100">{child.title}</h3>
                <p class="mt-1 text-sm leading-relaxed text-ink-600">{child.desc}</p>
                <p class="mt-4 text-sm font-medium text-ink-700 transition-colors group-hover:text-ink-100">
                  Read more <span aria-hidden="true">→</span>
                </p>
              </a>
            </li>
          ))}
        </ul>
      ) : (
        <ul class="mt-20 flex flex-col">
          {entry.children.map((child: any) => (
            <li class="border-t border-paper-500 py-6 first:border-t-0 first:pt-0">
              <a href={child.href} class="group block">
                <p class="text-lg font-semibold text-ink-100 group-hover:text-blue-500">{child.title}</p>
                {child.desc && (
                  <p class="mt-1 text-sm leading-relaxed text-ink-600">{child.desc}</p>
                )}
                <p class="mt-4 text-sm font-medium text-ink-700 transition-colors group-hover:text-ink-100">
                  Read more <span aria-hidden="true">→</span>
                </p>
              </a>
            </li>
          ))}
        </ul>
      )}

      <p class="mt-16 border-t border-dashed border-paper-600 pt-8">
        <a href="/help" class="text-sm font-semibold text-ink-100 underline underline-offset-4 hover:text-blue-500">
          Back to the Help Center
        </a>
      </p>
    </div>
  </div>
</BaseLayout>
