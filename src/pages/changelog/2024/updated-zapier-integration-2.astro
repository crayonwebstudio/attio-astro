---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Updated Zapier integration, copy fetched live from https://attio.com/changelog/2024/updated-zapier-integration-2
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2024/updated-zapier-integration-2");
if (!entry) throw new Error("Missing changelog data for /changelog/2024/updated-zapier-integration-2");
---

<ChangelogEntry entry={entry} />
