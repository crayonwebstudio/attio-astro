---
import HelpCategory from "../../../../components/HelpCategory.astro";
import help from "../../../../data/help.json";

// Suggestions, copy fetched live from https://attio.com/help/reference/attio-ai/suggestions
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/attio-ai/suggestions");
if (!entry) throw new Error("Missing help data for reference/attio-ai/suggestions");
---

<HelpCategory entry={entry} />
