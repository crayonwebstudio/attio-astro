---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Changelog (November 6, 2024), copy fetched live from https://attio.com/changelog/2024/changelog-november-6-2024-
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2024/changelog-november-6-2024-");
if (!entry) throw new Error("Missing changelog data for /changelog/2024/changelog-november-6-2024-");
---

<ChangelogEntry entry={entry} />
