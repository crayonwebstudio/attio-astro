---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for Surface Labs, copy fetched live from https://attio.com/apps/surface-labs
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "surface-labs");
if (!app) throw new Error("Missing app detail: surface-labs");
---

<AppDetail app={app} />
