---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Supported browsers, copy fetched live from https://attio.com/help/reference/support/supported-browsers
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/support/supported-browsers");
if (!entry) throw new Error("Missing help data for reference/support/supported-browsers");
---

<HelpArticle entry={entry} />
