---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Inconvo is joining Attio, copy fetched live from https://attio.com/blog/inconvo-is-joining-attio
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "inconvo-is-joining-attio");
if (!post) throw new Error("Missing post data for inconvo-is-joining-attio");
---

<BlogPost post={post} />
