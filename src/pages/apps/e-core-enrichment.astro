---
import AppDetail from "../../components/AppDetail.astro";
import details from "../../data/app-details.json";

// Detail page for eCore Enrichment, copy fetched live from https://attio.com/apps/e-core-enrichment
// on 2026-11-16 (HTTP 200). See src/components/AppDetail.astro.
const app = details.find((d) => d.slug === "e-core-enrichment");
if (!app) throw new Error("Missing app detail: e-core-enrichment");
---

<AppDetail app={app} />
