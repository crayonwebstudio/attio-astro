---
import ChangelogEntry from "../../../components/ChangelogEntry.astro";
import data from "../../../data/changelog-entries.json";

// Minimize your call screens, copy fetched live from https://attio.com/changelog/2025/minimize-your-call-screens
// on 2026-11-16 (HTTP 200). Data lives in src/data/changelog-entries.json.
const entry = (data as any).entries.find((entry: any) => entry.href === "/changelog/2025/minimize-your-call-screens");
if (!entry) throw new Error("Missing changelog data for /changelog/2025/minimize-your-call-screens");
---

<ChangelogEntry entry={entry} />
