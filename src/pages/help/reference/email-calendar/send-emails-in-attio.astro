---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Send emails in Attio, copy fetched live from https://attio.com/help/reference/email-calendar/send-emails-in-attio
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/email-calendar/send-emails-in-attio");
if (!entry) throw new Error("Missing help data for reference/email-calendar/send-emails-in-attio");
---

<HelpArticle entry={entry} />
