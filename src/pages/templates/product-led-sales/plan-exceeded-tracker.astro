---
import WorkflowTemplate from "../../../components/WorkflowTemplate.astro";
import templates from "../../../data/templates.json";

// Plan exceeded tracker, copy fetched live from https://attio.com/templates/product-led-sales/plan-exceeded-tracker
// on 2026-11-17 (HTTP 200). Data lives in src/data/templates.json.
const entry = (templates as any[]).find((entry) => entry.path === "/templates/product-led-sales/plan-exceeded-tracker");
if (!entry) throw new Error("Missing template data for /templates/product-led-sales/plan-exceeded-tracker");
---

<WorkflowTemplate entry={entry} />
