---
import BaseLayout from "../../layouts/BaseLayout.astro";

// Copy fetched live from https://attio.com/platform/sequences on 2026-11-16 (HTTP 200).
// Product visuals are rebuilt as HTML/CSS mocks, no Attio images are hotlinked or copied.
// Live H1 is "Sequences", used as the eyebrow, with the headline H2
// "Signal, sequence, success." as the single H1, same pattern as /platform/data.
// The "Handwritten warmth." H2 and "Customer details, auto-filled." H3 appear twice
// in the live DOM (desktop + mobile markup); rendered once here.
// "AI assist." and "Live accuracy." have titles only on the live page, rendered the same.
// The enrolled contacts list is duplicated in the live DOM (marquee), rendered here
// as a two-row marquee like the agent cards on /platform/workflows.
const followUpItems = [
  {
    n: "01",
    title: "Signal based enrollment.",
    copy: "Pick the cues, account created, form filled, RSVP, to enroll the contact.",
  },
  {
    n: "02",
    title: "One sequence, any sender.",
    copy: "Set up a single email sequence and auto-assign the right sender.",
  },
  {
    n: "03",
    title: "Automate scheduled sending.",
    copy: "Skip the CSVs and manual syncs. Reclaim hours every week.",
  },
];

const enrolled = [
  { name: "Esther Howard", enrolled: "Enrolled 3 days ago", next: "Automated email in 2 days" },
  { name: "Cody Fisher", enrolled: "Enrolled 2 days ago", next: "Automated email in 3 days" },
  { name: "Steve McCoy", enrolled: "Enrolled yesterday", next: "Automated email in 1 day" },
  { name: "Jessica Miles", enrolled: "Enrolled 6 hours ago", next: "Automated email in 2 days" },
  { name: "Bridget Smith", enrolled: "Enrolled 1 hour ago", next: "Automated email in 2 days" },
];

const warmthCards = [
  {
    title: "Customer details, auto-filled.",
    copy: "Drop in first names, renewal dates, or any field so each contact gets what's most relevant.",
    mockLabel: "Email draft",
    mock: [
      { label: "To", value: "Esther Howard" },
      { label: "First name", value: "Esther" },
      { label: "Renewal", value: "March 12, 2027" },
      { label: "Company", value: "Fieldstone" },
    ],
  },
  {
    title: "AI assist.",
    copy: null,
    mockLabel: "AI assist",
    mock: [
      { label: "Draft", value: "Follow-up in your voice" },
      { label: "Tone", value: "Warm, direct, short" },
      { label: "Length", value: "Under 120 words" },
    ],
  },
  {
    title: "Live accuracy.",
    copy: null,
    mockLabel: "Live check",
    mock: [
      { label: "Name", value: "Verified on the record" },
      { label: "Role", value: "Verified on the record" },
      { label: "Company", value: "Verified on the record" },
    ],
  },
];

const interactionItems = [
  {
    n: "01",
    title: "Track the journey.",
    copy: "See who progresses through each step.",
  },
  {
    n: "02",
    title: "Performance.",
    copy: "Track engagement to exit in one glance.",
  },
  {
    n: "03",
    title: "One-click control.",
    copy: "Pause, revive, or remove recipients with one click.",
  },
  {
    n: "04",
    title: "Smart sending.",
    copy: "Land in their inbox when they're ready.",
  },
];

const plugs = [
  "Ask Attio",
  "AI",
  "Data model",
  "Apps & integrations",
  "Call Intelligence",
  "Workflows",
  "Sequences",
  "Reporting",
];
---

<BaseLayout
  title="Sequences | Attio"
  description="Go from first touch to final signature with perfectly crafted emails delivered right on cue."
  finalCtaDemo
>
  <!-- Hero -->
  <section class="mx-auto max-w-[1200px] px-4 pb-12 pt-16 text-center sm:px-6 sm:pt-24">
    <p class="text-sm font-semibold uppercase tracking-[0.2em] text-blue-500">Sequences</p>
    <h1 class="mx-auto mt-6 max-w-4xl font-display text-[56px] font-semibold leading-[1.05] tracking-tight sm:text-[72px]">
      Signal, sequence, success.
    </h1>
    <p class="mx-auto mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 sm:text-xl">
      Go from first touch to final signature with perfectly crafted emails delivered right on cue.
    </p>
    <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/go/welcome/sign-in"
        class="rounded-full bg-ink-100 px-6 py-3 text-sm font-semibold text-white hover:bg-ink-300"
      >
        Start for free
      </a>
      <a
        href="/contact/sales"
        class="rounded-full border border-ink-100 px-6 py-3 text-sm font-semibold text-ink-100 hover:bg-paper-200"
      >
        Send me a demo
      </a>
      <a href="/contact/sales" class="px-4 py-3 text-sm font-semibold text-ink-100 underline underline-offset-4">
        Talk to sales
      </a>
    </div>

    <!-- Hero product mock: sequence timeline -->
    <div class="mx-auto mt-14 max-w-2xl overflow-hidden rounded-2xl border border-paper-500 bg-white text-left shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)]">
      <div class="flex items-center justify-between border-b border-paper-400 bg-paper-200 px-5 py-3">
        <p class="text-sm font-semibold">PQL Triage sequence</p>
        <span class="rounded-full bg-blue-100 px-3 py-1 text-xs font-semibold text-blue-600">Enrolled by PQL Triage</span>
      </div>
      <ol class="space-y-3 p-5 sm:p-6">
        <li class="flex items-center gap-3 rounded-xl border border-paper-500 p-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-blue-500 text-xs font-semibold text-white">1</span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold">Welcome Yara</p>
            <p class="text-xs text-ink-600">First touch, sent on enrollment</p>
          </div>
          <span class="shrink-0 rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700">Today</span>
        </li>
        <li class="flex items-center gap-3 rounded-xl border border-paper-500 p-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-paper-400 text-xs font-semibold text-ink-600">2</span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold">Follow-up, tailored to Yara</p>
            <p class="text-xs text-ink-600">Next step in the sequence</p>
          </div>
          <span class="shrink-0 rounded-full bg-paper-200 px-2.5 py-1 text-xs font-semibold text-ink-600">After 2 business days</span>
        </li>
        <li class="flex items-center gap-3 rounded-xl border border-paper-500 bg-paper-200 p-4">
          <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-full bg-green-500 text-xs font-semibold text-white">✓</span>
          <div class="min-w-0 flex-1">
            <p class="text-sm font-semibold">Booked meeting with Yara</p>
            <p class="text-xs text-ink-600">Sequence outcome, recorded in Attio</p>
          </div>
          <span class="shrink-0 rounded-full bg-green-100 px-2.5 py-1 text-xs font-semibold text-green-700">Completed, 4 days ago</span>
        </li>
      </ol>
    </div>
  </section>

  <!-- Step inside Sequences -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Step inside Sequences">
    <h2 class="max-w-2xl font-display text-heading-md font-semibold tracking-tight">Step inside Sequences.</h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      Convert warm signals into outreach that closes itself.
    </p>

    <h3 class="mt-12 font-display text-heading-sm font-semibold tracking-tight">Zero-touch follow-ups.</h3>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      Attio keeps conversations moving while your team focuses on winning.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {followUpItems.map((item) => (
        <article class="rounded-2xl border border-paper-500 bg-white p-6">
          <p class="font-display text-sm font-semibold text-blue-500">{item.n}</p>
          <h4 class="mt-2 font-display text-xl font-semibold">{item.title}</h4>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.copy}</p>
        </article>
      ))}
    </div>

    <!-- Enrolled contacts, duplicated rows like the live marquee -->
    <div class="marquee mt-10 overflow-hidden" aria-label="Enrolled contacts">
      <div class="marquee-track flex w-max gap-4 pr-4">
        {[...enrolled, ...enrolled].map((row) => (
          <article class="w-72 shrink-0 rounded-2xl border border-paper-500 bg-white p-5">
            <p class="text-sm font-semibold">{row.name}</p>
            <p class="mt-1 text-xs text-ink-600">{row.enrolled}</p>
            <p class="mt-3 rounded-lg bg-paper-200 px-3 py-2 text-xs font-medium text-ink-600">{row.next}</p>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Quote -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 text-center sm:px-6">
    <blockquote class="mx-auto max-w-3xl font-serif text-2xl leading-snug text-ink-100 sm:text-3xl">
      With Attio, we're able to conduct highly targeted and customized outreach.
    </blockquote>
    <p class="mt-6 text-sm font-semibold">Margaret Shen</p>
    <p class="mt-1 text-sm text-ink-600">Head of Business Operations, Modal</p>
  </section>

  <!-- Handwritten warmth -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Handwritten warmth">
    <h2 class="max-w-2xl font-display text-heading-md font-semibold tracking-tight">Handwritten warmth.</h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      Every touch feels 1-to-1, even when juggling 100 accounts.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-3">
      {warmthCards.map((card) => (
        <article class="overflow-hidden rounded-2xl border border-paper-500 bg-white">
          <div class="border-b border-paper-400 bg-paper-200 p-5">
            <p class="text-xs font-semibold uppercase tracking-[0.15em] text-ink-700">{card.mockLabel}</p>
            <ul class="mt-4 space-y-2">
              {card.mock.map((row) => (
                <li class="flex items-baseline gap-2 rounded-lg bg-white px-3 py-2 text-sm shadow-sm">
                  <span class="shrink-0 text-xs font-semibold uppercase tracking-wide text-ink-700">{row.label}</span>
                  <span class="text-ink-600">{row.value}</span>
                </li>
              ))}
            </ul>
          </div>
          <div class="p-6">
            <h3 class="font-display text-xl font-semibold">{card.title}</h3>
            {card.copy && <p class="mt-2 text-sm leading-relaxed text-ink-600">{card.copy}</p>}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Every interaction in Attio -->
  <section class="mx-auto max-w-[1200px] px-4 pb-20 sm:px-6" aria-label="Every interaction in Attio">
    <h2 class="max-w-2xl font-display text-heading-md font-semibold tracking-tight">Every interaction in Attio.</h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      Track enrollment, replies, meetings, and status for every contact.
    </p>
    <div class="mt-10 grid gap-6 sm:grid-cols-2 lg:grid-cols-4">
      {interactionItems.map((item) => (
        <article class="rounded-2xl border border-paper-500 bg-white p-6">
          <p class="font-display text-sm font-semibold text-blue-500">{item.n}</p>
          <h3 class="mt-2 font-display text-xl font-semibold">{item.title}</h3>
          <p class="mt-2 text-sm leading-relaxed text-ink-600">{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <!-- Attio plugs in -->
  <section class="mx-auto max-w-[1200px] px-4 pb-24 sm:px-6" aria-label="Attio plugs in">
    <h2 class="max-w-2xl font-display text-heading-md font-semibold tracking-tight">Attio plugs in. You take off.</h2>
    <p class="mt-3 max-w-2xl text-lg leading-relaxed text-ink-600">
      Work your way, from outreach to outcomes.
    </p>
    <ul class="mt-10 flex flex-wrap gap-3">
      {plugs.map((plug, i) => (
        <li class="flex items-center gap-2 rounded-full border border-paper-500 bg-white px-4 py-2 text-sm font-medium">
          <span class="flex h-5 w-5 items-center justify-center rounded-full bg-blue-100 text-xs font-semibold text-blue-600">
            {i + 1}
          </span>
          {plug}
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
