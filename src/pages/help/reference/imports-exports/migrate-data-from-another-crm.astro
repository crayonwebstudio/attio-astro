---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Migrate data from another CRM, copy fetched live from https://attio.com/help/reference/imports-exports/migrate-data-from-another-crm
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/imports-exports/migrate-data-from-another-crm");
if (!entry) throw new Error("Missing help data for reference/imports-exports/migrate-data-from-another-crm");
---

<HelpArticle entry={entry} />
