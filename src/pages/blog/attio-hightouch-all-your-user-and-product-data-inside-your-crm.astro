---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Attio + Hightouch: All your user and product data inside your CRM, copy fetched live from https://attio.com/blog/attio-hightouch-all-your-user-and-product-data-inside-your-crm
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "attio-hightouch-all-your-user-and-product-data-inside-your-crm");
if (!post) throw new Error("Missing post data for attio-hightouch-all-your-user-and-product-data-inside-your-crm");
---

<BlogPost post={post} />
