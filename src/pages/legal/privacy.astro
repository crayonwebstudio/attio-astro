---
import LegalLayout from "../../components/LegalLayout.astro";
import legal from "../../data/legal.json";

// Privacy Policy, copy fetched live from https://attio.com/legal/privacy
// on 2026-11-16 (HTTP 200). Data lives in src/data/legal.json.
const entry = (legal as any[]).find((entry) => entry.slug === "privacy");
if (!entry) throw new Error("Missing legal data for privacy");
---

<LegalLayout entry={entry} />
