---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Attio + June: Bring product data to your CRM, copy fetched live from https://attio.com/blog/attio-june-integration
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "attio-june-integration");
if (!post) throw new Error("Missing post data for attio-june-integration");
---

<BlogPost post={post} />
