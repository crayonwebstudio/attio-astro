---

<BaseLayout
  title="Insights & updates | Attio Blog"
  description="Learn more about Attio, CRM, and GTM from members of our team and industry-leading experts."
  hideFinalCta
>
  <!-- Page heading -->
  <section class="mx-auto max-w-[1200px] px-4 pb-10 pt-16 sm:px-6 sm:pt-24">
    <h1 class="font-display text-[44px] font-semibold leading-[1.05] tracking-tight sm:text-[72px]">
      Insights &amp; updates
    </h1>
    <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-600 sm:text-xl">
      Learn more about Attio, CRM, and GTM from members of our team and industry-leading
      experts.
    </p>
  </section>

  <!-- Featured hero -->
  <section class="mx-auto max-w-[1200px] px-4 pb-12 sm:px-6" aria-label="Featured article">
    <a
      href={`/blog/${hero.slug}`}
      class="group grid overflow-hidden rounded-2xl border border-paper-500 bg-white transition-shadow hover:shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)] lg:grid-cols-2"
    >
      <div class="flex min-h-[280px] items-center justify-center bg-ink-50 bg-[repeating-linear-gradient(-45deg,transparent,transparent_12px,rgba(255,255,255,0.04)_12px,rgba(255,255,255,0.04)_13px)] p-8 sm:min-h-[360px]">
        <p class="text-center font-display text-2xl font-semibold tracking-tight text-white sm:text-3xl">
          {hero.tag}
        </p>
      </div>
      <div class="flex flex-col justify-center p-6 sm:p-10">
        <p class="flex items-center justify-between gap-4 text-sm font-medium text-ink-600">
          <span>[ {hero.tag} ]</span>
          <span>
            {hero.date} <span class="mx-1 text-ink-800">·</span> 4 min read
          </span>
        </p>
        <h2 class="mt-6 font-display text-heading-sm font-semibold tracking-tight sm:text-heading-md">
          {hero.title}
        </h2>
        <p class="mt-4 text-base leading-relaxed text-ink-600">{hero.excerpt}</p>
        <p class="mt-6 text-sm">
          <span class="font-semibold">Nicolas Sharp</span>
          <span class="text-ink-600">, CEO &amp; Co-founder</span>
        </p>
      </div>
    </a>

    <!-- Secondary featured cards -->
    <div class="mt-6 grid gap-6 md:grid-cols-3">
      {featured.map(({ post, authors }) => (
        <a
          href={`/blog/${post.slug}`}
          class="group flex flex-col overflow-hidden rounded-2xl border border-paper-500 bg-white transition-shadow hover:shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)]"
        >
          <div class="flex min-h-[180px] items-center justify-center bg-ink-50 bg-[repeating-linear-gradient(-45deg,transparent,transparent_12px,rgba(255,255,255,0.04)_12px,rgba(255,255,255,0.04)_13px)] p-6">
            <p class="text-center font-display text-xl font-semibold tracking-tight text-white">
              {post.tag}
            </p>
          </div>
          <div class="flex flex-1 flex-col p-6">
            <p class="flex items-center justify-between gap-4 text-sm font-medium text-ink-600">
              <span>[ {post.tag} ]</span>
              <span>{post.date}</span>
            </p>
            <h3 class="mt-4 font-display text-2xl font-semibold tracking-tight">
              {post.title}
            </h3>
            <p class="mt-3 line-clamp-2 text-sm leading-relaxed text-ink-600">{post.excerpt}</p>
            <div class="mt-5 space-y-1">
              {authors.map((author) => (
                <p class="truncate text-sm">
                  <span class="font-semibold">{author.name}</span>
                  <span class="text-ink-600">, {author.role}</span>
                </p>
              ))}
            </div>
          </div>
        </a>
      ))}
    </div>
  </section>

  <!-- Latest articles -->
  <section class="mx-auto max-w-[1200px] px-4 pb-24 sm:px-6" aria-label="Latest articles">
    <div class="border-t border-paper-500 pt-10">
      <h2 class="font-display text-heading-md font-semibold tracking-tight">Latest articles</h2>
    </div>

    <!-- Filter chips, live labels and counts -->
    <ul id="blog-filters" class="mt-8 flex flex-wrap gap-2" aria-label="Filter articles by category">
      {filters.map((filter, i) => (
        <li>
          <button
            type="button"
            data-filter={filter.tag}
            aria-pressed={i === 0 ? "true" : "false"}
            class:list={[
              "rounded-xl border px-3.5 py-2 text-lg font-medium transition-colors",
              i === 0
                ? "border-ink-100 bg-ink-100 text-white"
                : "border-paper-500 bg-white text-ink-100 hover:border-ink-800",
            ]}
          >
            {filter.label}
            <span class="align-super text-xs">[{filter.count}]</span>
          </button>
        </li>
      ))}
    </ul>

    <!-- Article list, live order, newest first -->
    <div id="blog-list" class="mt-10 grid gap-6 md:grid-cols-2 lg:grid-cols-3">
      {posts.map((post) => (
        <article
          class="blog-card group flex flex-col overflow-hidden rounded-2xl border border-paper-500 bg-white transition-shadow hover:shadow-[0_24px_64px_-24px_rgba(16,16,16,0.25)]"
          data-tag={post.tag}
        >
          <a href={`/blog/${post.slug}`} class="flex min-h-[160px] items-center justify-center bg-ink-50 bg-[repeating-linear-gradient(-45deg,transparent,transparent_12px,rgba(255,255,255,0.04)_12px,rgba(255,255,255,0.04)_13px)] p-6">
            <p class="text-center font-display text-lg font-semibold tracking-tight text-white">
              {post.tag}
            </p>
          </a>
          <div class="flex flex-1 flex-col p-6">
            <p class="flex items-center justify-between gap-4 text-sm font-medium text-ink-600">
              <span>[ {post.tag} ]</span>
              <span>{post.date}</span>
            </p>
            <h3 class="mt-4 font-display text-2xl font-semibold tracking-tight">
              <a href={`/blog/${post.slug}`}>{post.title}</a>
            </h3>
            <p class="mt-3 line-clamp-3 text-sm leading-relaxed text-ink-600">{post.excerpt}</p>
          </div>
        </article>
      ))}
    </div>
    <p id="blog-empty" class="mt-10 hidden text-base text-ink-600">
      No articles in this category yet.
    </p>
  </section>
</BaseLayout>

<script>
  // Filter the article list by category, as on live. Counts are the live totals.
  const filterList = document.getElementById("blog-filters");
  const cards = Array.from(document.querySelectorAll(".blog-card"));
  const empty = document.getElementById("blog-empty");
  if (filterList) {
    filterList.addEventListener("click", (event) => {
      const button = event.target.closest("button[data-filter]");
      if (!button) return;
      const tag = button.getAttribute("data-filter");
      let visible = 0;
      cards.forEach((card) => {
        const show = tag === "All" || card.getAttribute("data-tag") === tag;
        card.classList.toggle("hidden", !show);
        if (show) visible += 1;
      });
      if (empty) empty.classList.toggle("hidden", visible > 0);
      filterList.querySelectorAll("button[data-filter]").forEach((other) => {
        const active = other === button;
        other.setAttribute("aria-pressed", active ? "true" : "false");
        other.classList.toggle("border-ink-100", active);
        other.classList.toggle("bg-ink-100", active);
        other.classList.toggle("text-white", active);
        other.classList.toggle("border-paper-500", !active);
        other.classList.toggle("bg-white", !active);
        other.classList.toggle("text-ink-100", !active);
      });
    });
  }
</script>
