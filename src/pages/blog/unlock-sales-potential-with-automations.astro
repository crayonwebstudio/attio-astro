---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Unlock sales potential with Workflows, copy fetched live from https://attio.com/blog/unlock-sales-potential-with-automations
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "unlock-sales-potential-with-automations");
if (!post) throw new Error("Missing post data for unlock-sales-potential-with-automations");
---

<BlogPost post={post} />
