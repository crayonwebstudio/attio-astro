---
import HelpCategory from "../../../components/HelpCategory.astro";
import help from "../../../data/help.json";

// Account settings, copy fetched live from https://attio.com/help/reference/account-settings
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/account-settings");
if (!entry) throw new Error("Missing help data for reference/account-settings");
---

<HelpCategory entry={entry} />
