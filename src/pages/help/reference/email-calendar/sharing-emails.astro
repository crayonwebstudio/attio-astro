---
import HelpArticle from "../../../../components/HelpArticle.astro";
import help from "../../../../data/help.json";

// Share emails with your team, copy fetched live from https://attio.com/help/reference/email-calendar/sharing-emails
// on 2026-11-16 (HTTP 200). Data lives in src/data/help.json.
const entry = (help as any[]).find((entry) => entry.slug === "reference/email-calendar/sharing-emails");
if (!entry) throw new Error("Missing help data for reference/email-calendar/sharing-emails");
---

<HelpArticle entry={entry} />
