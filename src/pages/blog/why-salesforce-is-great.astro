---
import BlogPost from "../../components/BlogPost.astro";
import posts from "../../data/posts.json";

// Why Salesforce is great, copy fetched live from https://attio.com/blog/why-salesforce-is-great
// on 2026-11-16 (HTTP 200). Data lives in src/data/posts.json.
const post = posts.find((entry) => entry.slug === "why-salesforce-is-great");
if (!post) throw new Error("Missing post data for why-salesforce-is-great");
---

<BlogPost post={post} />
